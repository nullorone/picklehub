{
    "name": "picklehub",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "homepage": "https://nullorone.github.io/picklehub",
    "workspaces": [
        "frontend/tg",
        "frontend/packages/tokens",
        "frontend/packages/api",
        "ds/tokens",
        "ds/web",
        "ds/storybook",
        "backend"
    ],
    "scripts": {
        "start": "npm run dev --workspace @picklehub/tg --",
        "start:https": "npm run dev:https --workspace @picklehub/tg --",
        "start:backend": "npm run start:dev --workspace @picklehub/backend",
        "build": "npm run build --workspace @picklehub/tg",
        "lint": "eslint frontend/tg/src --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint frontend/tg/src --report-unused-disable-directives --max-warnings 0 --fix",
        "typecheck": "tsc --project frontend/tg/tsconfig.json --noEmit && tsc --project frontend/tg/tsconfig.node.json --noEmit",
        "format": "prettier --write \"frontend/tg/**/*.{ts,tsx,css,html,json}\" package.json eslint.config.js",
        "format:check": "prettier --check \"frontend/tg/**/*.{ts,tsx,css,html,json}\" package.json eslint.config.js",
        "preview": "npm run preview --workspace @picklehub/tg",
        "deploy": "gh-pages -d frontend/tg/dist",
        "predeploy": "npm run build",
        "ds:tokens": "npm run build --workspace @picklehub/design-tokens",
        "ds:dev": "npm run ds:tokens && npm run dev --workspace @picklehub/storybook",
        "ds:build": "npm run ds:tokens && npm run build --workspace @picklehub/storybook",
        "ds:format": "prettier --write ds",
        "ds:format:check": "prettier --check ds",
        "ds:lint": "eslint ds frontend/packages/tokens --report-unused-disable-directives --max-warnings 0",
        "ds:typecheck": "npm run typecheck --workspace @picklehub/design-tokens && npm run typecheck --workspace @picklehub/ui-web && npm run typecheck --workspace @picklehub/storybook",
        "ds:test": "npm run ds:tokens && npm test --workspace @picklehub/storybook",
        "ds:check": "npm run ds:format:check && npm run ds:lint && npm run ds:typecheck && npm run ds:test && npm run ds:build"
    },
    "devDependencies": {
        "@eslint/js": "^9.23.0",
        "@typescript-eslint/eslint-plugin": "^8.28.0",
        "@typescript-eslint/parser": "^8.28.0",
        "@typespec/compiler": "1.17.0",
        "@typespec/http": "1.17.0",
        "@typespec/openapi3": "1.17.0",
        "eslint": "^9.34.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "gh-pages": "^6.3.0",
        "globals": "^15.15.0",
        "openapi-fetch": "0.17.0",
        "prettier": "^3.5.3",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.40.0"
    },
    "msw": {
        "workerDirectory": [
            "frontend/tg/public"
        ]
    }
}
