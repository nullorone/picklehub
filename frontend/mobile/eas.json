{
    "cli": { "appVersionSource": "remote", "version": ">= 16.0.0" },
    "build": {
        "development": {
            "channel": "development",
            "developmentClient": true,
            "distribution": "internal",
            "env": { "APP_ENV": "development" }
        },
        "preview": {
            "channel": "preview",
            "distribution": "internal",
            "env": { "APP_ENV": "development" }
        },
        "production": { "autoIncrement": true, "channel": "production", "env": { "APP_ENV": "production" } }
    },
    "submit": { "production": {} }
}
