{
    "name": "@picklehub/mobile",
    "version": "0.1.0",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "build": "expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android && node scripts/check-build.mjs",
        "build:release:audit": "APP_ENV=production EXPO_PUBLIC_API_URL=https://api.picklehub.ru/v1 expo export --platform ios --output-dir dist/ios && APP_ENV=production EXPO_PUBLIC_API_URL=https://api.picklehub.ru/v1 expo export --platform android --output-dir dist/android && APP_ENV=production EXPO_PUBLIC_API_URL=https://api.picklehub.ru/v1 expo config --type public --json > dist/public-config.json && node scripts/check-release.mjs",
        "dev": "expo start",
        "lint": "eslint src App.tsx app.config.ts index.ts --max-warnings=0",
        "test": "vitest run",
        "test:e2e": "maestro test .maestro/flows",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@noble/ciphers": "^1.3.0",
        "@picklehub/analytics": "0.1.0",
        "@picklehub/api-client": "0.1.0",
        "@picklehub/domain": "0.1.0",
        "@picklehub/i18n": "0.1.0",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-native-community/netinfo": "^11.4.1",
        "@react-navigation/bottom-tabs": "^7.4.7",
        "@react-navigation/native": "^7.1.17",
        "@react-navigation/native-stack": "^7.3.26",
        "expo": "~55.0.0",
        "expo-application": "~55.0.0",
        "expo-build-properties": "~55.0.0",
        "expo-crypto": "~55.0.0",
        "expo-constants": "~55.0.0",
        "expo-linking": "~55.0.0",
        "expo-location": "~55.1.14",
        "expo-notifications": "~55.0.0",
        "expo-secure-store": "~55.0.0",
        "expo-status-bar": "~55.0.0",
        "react": "19.2.0",
        "react-native": "0.83.10",
        "react-native-gesture-handler": "2.30.1",
        "react-native-maps": "1.27.2",
        "react-native-safe-area-context": "5.6.2",
        "react-native-screens": "4.23.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.2",
        "eslint": "9.35.0",
        "typescript": "5.9.2",
        "vitest": "5.0.0"
    }
}
