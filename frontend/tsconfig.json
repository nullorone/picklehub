{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": false,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "types": ["vite/client"]
    }
}
