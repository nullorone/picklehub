  checkInState  String                 @map("check_in_state") @db.VarChar(24)
  registeredAt  DateTime               @default(now()) @map("registered_at") @db.Timestamptz(3)
  terminalAt    DateTime?              @map("terminal_at") @db.Timestamptz(3)
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members       EntrantMember[]
  paymentMarks  PaymentMark[]
  standings     Standing[]

  @@index([tournamentId, state, registeredAt, id], map: "entrants_roster_idx")
  @@index([tournamentId, state, fifoSequence], map: "entrants_fifo_idx")
  @@map("tournament_entrants")
}

model EntrantMember {
  id           String                @id @db.Uuid
  tournamentId String                @map("tournament_id") @db.Uuid
  entrantId    String                @map("entrant_id") @db.Uuid
  userId       String                @map("user_id") @db.Uuid
