// Tournaments use one aggregate family for every allowlisted format. Cross-row slot, active-member, ownership,
// immutable snapshot and projection invariants are enforced by the additive SQL migration.
enum TournamentFormatCode {
  AMERICANO
  ROUND_ROBIN
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  POOL_PLAY
  SWISS
  LADDER
  KING_OF_COURT
  CUSTOM_DSL

  @@map("tournament_format_code")
}

enum TournamentState {
  DRAFT
  PUBLISHED
  CHECK_IN
  SEEDED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED

  @@map("tournament_state")
}

enum TournamentRegistrationGate {
  OPEN
  CLOSED

  @@map("tournament_registration_gate")
}

enum TournamentPlayMode {
  INDIVIDUAL_DOUBLES
  SINGLES
  FIXED_TEAM_DOUBLES

  @@map("tournament_play_mode")
}

enum TournamentEntrantState {
  ELIGIBLE
  WAITLISTED
  WITHDRAWN
  REPLACED
  NO_SHOW

  @@map("tournament_entrant_state")
}

enum TournamentMemberState {
  PENDING_CONFIRMATION
  CONFIRMED
  WITHDRAWN
  REPLACED
  NO_SHOW

  @@map("tournament_member_state")
}

enum TournamentStageKind {
  LEAGUE
  POOL
  WINNERS
  LOSERS
  PLAYOFF
  FINAL
  BRONZE
  LADDER
  COURT

  @@map("tournament_stage_kind")
}

enum TournamentRoundState {
  PLANNED
  READY
  IN_PROGRESS
  COMPLETED

  @@map("tournament_round_state")
}

enum TournamentMatchState {
  PLANNED
  READY
  IN_PROGRESS
  COMPLETED
  BYE
  WALKOVER
  DOUBLE_WALKOVER
  VOID

  @@map("tournament_match_state")
}

enum TournamentSlotSourceOutcome {
  WINNER
  LOSER

  @@map("tournament_slot_source_outcome")
}

enum TournamentPaymentState {
  NOT_REQUIRED
  PENDING_EXTERNAL
  MARKED_PAID
  WAIVED
  REFUND_REPORTED

  @@map("tournament_payment_state")
}

enum TournamentPartnerIntentState {
  PENDING
  PAIRED
  WAITLISTED
  WITHDRAWN
  EXPIRED

  @@map("tournament_partner_intent_state")
}

enum TournamentScopedRole {
  ORGANIZER
  CO_ORGANIZER
  SCOREKEEPER

  @@map("tournament_scoped_role")
}

model FormatDefinition {
  id              String               @id @db.Uuid
  formatCode      TournamentFormatCode @map("format_code")
  strategyVersion String               @map("strategy_version") @db.VarChar(24)
  schemaVersion   String               @map("schema_version") @db.VarChar(24)
  schemaId        String               @map("schema_id") @db.VarChar(200)
  schema          Json
  schemaHash      String               @map("schema_hash") @db.Char(64)
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  tournaments     Tournament[]

  @@unique([formatCode, strategyVersion, schemaVersion], map: "format_definitions_version_key")
  @@map("format_definitions")
}

model Tournament {
  id                   String                     @id @db.Uuid
  version              Int                        @default(0)
  projectionRevision   BigInt                     @default(0) @map("projection_revision")
  projectionChecksum   String?                    @map("projection_checksum") @db.Char(64)
  state                TournamentState            @default(DRAFT)
  registrationGate     TournamentRegistrationGate @default(CLOSED) @map("registration_gate")
  organizerId          String                     @map("organizer_id") @db.Uuid
  clubId               String?                    @map("club_id") @db.Uuid
  venueId              String                     @map("venue_id") @db.Uuid
  formatDefinitionId   String                     @map("format_definition_id") @db.Uuid
  formatSnapshot       Json                       @map("format_snapshot")
  formatSnapshotHash   String                     @map("format_snapshot_hash") @db.Char(64)
  name                 String                     @db.VarChar(120)
  description          String                     @db.VarChar(2000)
  timeZone             String                     @map("time_zone") @db.VarChar(64)
  startsAt             DateTime                   @map("starts_at") @db.Timestamptz(3)
  registrationOpensAt  DateTime                   @map("registration_opens_at") @db.Timestamptz(3)
  registrationClosesAt DateTime                   @map("registration_closes_at") @db.Timestamptz(3)
  checkInClosesAt      DateTime?                  @map("check_in_closes_at") @db.Timestamptz(3)
  capacity             Int                        @db.SmallInt
  priceMinor           BigInt?                    @map("price_minor")
  currency             String?                    @db.Char(3)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(3)
  completedAt          DateTime?                  @map("completed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?                  @map("cancelled_at") @db.Timestamptz(3)
  formatDefinition     FormatDefinition           @relation(fields: [formatDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entrants             Entrant[]
  stages               Stage[]
  matches              TournamentMatch[]
  standings            Standing[]
  partnerIntents       TournamentPartnerIntent[]
  roles                TournamentRole[]

  @@index([state, startsAt, id], map: "tournaments_public_search_idx")
  @@index([organizerId, state, updatedAt], map: "tournaments_organizer_idx")
  @@index([clubId, state, startsAt], map: "tournaments_club_idx")
  @@map("tournaments")
}

model Entrant {
  id            String                 @id @db.Uuid
  tournamentId  String                 @map("tournament_id") @db.Uuid
  state         TournamentEntrantState @default(ELIGIBLE)
  revision      Int                    @default(0)
