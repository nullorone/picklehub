  @@index([scopeKind, clubId, lifetimeNetXp], map: "xp_balances_scope_idx")
  @@map("xp_balances")
}

model LevelDefinition {
  id            String            @id @db.Uuid
  scopeKind     GamificationScopeKind @map("scope_kind")
  clubId        String?           @map("club_id") @db.Uuid
  version       String            @db.VarChar(32)
  ordinal       Int               @db.SmallInt
  name          String            @db.VarChar(30)
  thresholdXp   BigInt            @map("threshold_xp")
  effectiveFrom DateTime          @map("effective_from") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("level_definitions")
}

model AchievementDefinition {
  id             String            @id @db.Uuid
  scopeKind      GamificationScopeKind @map("scope_kind")
  code           String            @db.VarChar(96)
  version        String            @db.VarChar(32)
  sourceKind     XpSourceKind      @map("source_kind")
  thresholdCount Int               @map("threshold_count")
  title          String            @db.VarChar(80)
  description    String            @db.VarChar(300)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([scopeKind, code, version], map: "achievement_definitions_scope_code_version_key")
  @@map("achievement_definitions")
}

model AchievementAward {
