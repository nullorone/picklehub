generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  QUARANTINED

  @@map("outbox_status")
}

model OutboxEvent {
  id            String       @id @db.Uuid
  type          String       @db.VarChar(160)
  schemaVersion Int          @map("schema_version")
  payload       Json
  correlationId String       @map("correlation_id") @db.Uuid
  causationId   String?      @map("causation_id") @db.Uuid
  occurredAt    DateTime     @map("occurred_at") @db.Timestamptz(3)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  claimedAt     DateTime?    @map("claimed_at") @db.Timestamptz(3)
  claimedBy     String?      @map("claimed_by") @db.Uuid
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  lastErrorCode String?      @map("last_error_code") @db.VarChar(96)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt, occurredAt], map: "outbox_events_dispatch_idx")
  @@map("outbox_events")
}

model AuditEntry {
  id            String   @id @db.Uuid
  operationId   String?  @unique(map: "audit_entries_operation_key") @map("operation_id") @db.Uuid
  actorType     String   @map("actor_type") @db.VarChar(64)
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(160)
  targetType    String   @map("target_type") @db.VarChar(96)
  targetId      String?  @map("target_id") @db.Uuid
  outcome       String   @db.VarChar(48)
  reasonCode    String?  @map("reason_code") @db.VarChar(96)
  policyVersion String?  @map("policy_version") @db.VarChar(128)
  changedFields Json     @map("changed_fields")
  requestId     String   @map("request_id") @db.Uuid
  correlationId String   @map("correlation_id") @db.Uuid
  source        String   @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt], map: "audit_entries_target_idx")
  @@index([actorId, createdAt], map: "audit_entries_actor_idx")
  @@map("audit_entries")
}

// Administration data contract. Capabilities remain code-defined and are intentionally not persisted as grants.
enum PlatformRole {
  SUPERADMIN
  MODERATOR
  EDITOR
  ADS_MANAGER

  @@map("platform_role")
}

enum AdminMfaMethod {
  WEBAUTHN
  HARDWARE_KEY

  @@map("admin_mfa_method")
}

enum AdminRestrictionScope {
  DIRECT_INTERACTIONS
  MATCH_CREATION
  PLATFORM_ACCESS

  @@map("admin_restriction_scope")
}

enum AdminRestrictionState {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("admin_restriction_state")
}

model PlatformRoleGrant {
  id                String         @id @db.Uuid
  subjectUserId     String         @map("subject_user_id") @db.Uuid
  role              PlatformRole
  grantedByUserId   String         @map("granted_by_user_id") @db.Uuid
  approvedByUserId  String         @map("approved_by_user_id") @db.Uuid
  reasonCode        String         @map("reason_code") @db.VarChar(96)
  policyVersion     String         @map("policy_version") @db.VarChar(128)
  approvalReference String         @map("approval_reference") @db.VarChar(160)
  revision          Int            @default(0)
  validFrom         DateTime       @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil        DateTime?      @map("valid_until") @db.Timestamptz(3)
  reviewAt          DateTime       @map("review_at") @db.Timestamptz(3)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId   String?        @map("revoked_by_user_id") @db.Uuid
  revokeReasonCode  String?        @map("revoke_reason_code") @db.VarChar(96)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)
  adminSessions     AdminSession[]

  @@index([subjectUserId, role, revokedAt, validUntil], map: "platform_role_grants_access_idx")
  @@index([reviewAt, revokedAt], map: "platform_role_grants_review_idx")
  @@map("platform_role_grants")
}

model AdminSession {
  id                String            @id @db.Uuid
  staffUserId       String            @map("staff_user_id") @db.Uuid
  roleGrantId       String            @map("role_grant_id") @db.Uuid
  audience          String            @default("picklehub-admin") @db.VarChar(32)
  credentialHash    String            @unique(map: "admin_sessions_credential_hash_key") @map("credential_hash") @db.Char(64)
  mfaMethod         AdminMfaMethod    @map("mfa_method")
  mfaVerifiedAt     DateTime          @map("mfa_verified_at") @db.Timestamptz(3)
  reauthenticatedAt DateTime?         @map("reauthenticated_at") @db.Timestamptz(3)
  securityEpoch     Int               @map("security_epoch")
  lastSeenAt        DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime          @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime          @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?         @map("revoked_at") @db.Timestamptz(3)
  revokeReasonCode  String?           @map("revoke_reason_code") @db.VarChar(96)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  roleGrant         PlatformRoleGrant @relation(fields: [roleGrantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([staffUserId, revokedAt, absoluteExpiresAt], map: "admin_sessions_staff_access_idx")
  @@index([idleExpiresAt, absoluteExpiresAt], map: "admin_sessions_expiry_idx")
  @@map("admin_sessions")
}

model BreakGlassGrant {
  id                      String    @id @db.Uuid
  actorUserId             String    @map("actor_user_id") @db.Uuid
  caseId                  String    @map("case_id") @db.Uuid
  incidentReference       String    @map("incident_reference") @db.VarChar(160)
  reasonCode              String    @map("reason_code") @db.VarChar(96)
  policyVersion           String    @map("policy_version") @db.VarChar(128)
  justificationCiphertext Bytes     @map("justification_ciphertext")
  encryptionKeyVersion    Int       @map("encryption_key_version")
  revision                Int       @default(0)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt               DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt               DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId         String?   @map("revoked_by_user_id") @db.Uuid
  revokeReasonCode        String?   @map("revoke_reason_code") @db.VarChar(96)

  @@index([actorUserId, caseId, expiresAt, revokedAt], map: "break_glass_grants_access_idx")
  @@index([expiresAt, revokedAt], map: "break_glass_grants_expiry_idx")
  @@map("break_glass_grants")
}

model AdminOperationReceipt {
  id                   String   @id @db.Uuid
  actorUserId          String   @map("actor_user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(200)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  targetType           String   @map("target_type") @db.VarChar(96)
  targetId             String?  @map("target_id") @db.Uuid
  expectedRevision     Int      @map("expected_revision")
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  auditEntryId         String?  @map("audit_entry_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)

  @@unique([actorUserId, method, canonicalPath, idempotencyKey], map: "admin_operation_receipts_scope_key")
  @@unique([auditEntryId], map: "admin_operation_receipts_audit_key")
  @@index([expiresAt], map: "admin_operation_receipts_expiry_idx")
  @@map("admin_operation_receipts")
}

model UserRestriction {
  id               String                @id @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  decisionId       String                @map("decision_id") @db.Uuid
  scope            AdminRestrictionScope
  state            AdminRestrictionState @default(ACTIVE)
  reasonCode       String                @map("reason_code") @db.VarChar(96)
  policyVersion    String                @map("policy_version") @db.VarChar(128)
  revision         Int                   @default(0)
  createdByUserId  String                @map("created_by_user_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime?             @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId  String?               @map("revoked_by_user_id") @db.Uuid
  revokeReasonCode String?               @map("revoke_reason_code") @db.VarChar(96)
  updatedAt        DateTime              @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([decisionId, scope], map: "user_restrictions_decision_scope_key")
  @@index([userId, state, expiresAt], map: "user_restrictions_effective_idx")
  @@map("user_restrictions")
}

// Identity data contract. SQL migration also owns CHECKs, partial indexes and deferred triggers.
enum IdentityProvider {
  TELEGRAM
  EMAIL

  @@map("identity_provider")
}

enum UserStatus {
  ACTIVE
  DELETION_PENDING
  DELETED

  @@map("identity_user_status")
}

enum ConsentPurpose {
  TERMS
  PERSONAL_DATA
  ANALYTICS
  MARKETING

  @@map("consent_purpose")
}

enum ConsentAction {
  ACCEPTED
  WITHDRAWN

  @@map("consent_action")
}

model User {
  id                              String                           @id @db.Uuid
  status                          UserStatus                       @default(ACTIVE)
  authEpoch                       Int                              @default(0) @map("auth_epoch")
  createdAt                       DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt                     DateTime                         @default(now()) @map("last_login_at") @db.Timestamptz(3)
  completedAt                     DateTime?                        @map("completed_at") @db.Timestamptz(3)
  deletionRequestedAt             DateTime?                        @map("deletion_requested_at") @db.Timestamptz(3)
  deletedAt                       DateTime?                        @map("deleted_at") @db.Timestamptz(3)
  identities                      Identity[]
  sessions                        Session[]
  draft                           PlayerProfileDraft?
  consents                        Consent[]
  attempts                        IdentityAttempt[]
  magicLinks                      MagicLink[]
  idempotencyRecords              IdentityIdempotencyRecord[]
  venueCandidates                 VenueCandidate[]
  venueRevisions                  VenueRevision[]
  venueReports                    VenueReport[]
  venueSources                    VenueSource[]
  venueDecisions                  VenueModerationDecision[]
  organizedMatches                Match[]                          @relation("MatchOrganizer")
  matchParticipants               MatchParticipant[]
  matchGuestOwners                MatchGuestSlot[]
  matchJoinRequests               JoinRequest[]
  matchWaitlist                   WaitlistEntry[]
  resultProposals                 MatchResult[]                    @relation("MatchResultProposer")
  resultConfirmations             ResultConfirmation[]
  conversationMemberships         ConversationMembership[]
  authoredChatMessages            ChatMessage[]                    @relation("ChatMessageAuthor")
  chatMessageRevisions            ChatMessageRevision[]            @relation("ChatRevisionCreator")
  chatMessageReports              ChatMessageReport[]              @relation("ChatReportReporter")
  communicationBlocksMade         CommunicationBlock[]             @relation("CommunicationBlocker")
  communicationBlocksReceived     CommunicationBlock[]             @relation("CommunicationBlocked")
  notificationPreference          NotificationPreference?
  notifications                   Notification[]
  notificationDevices             NotificationDevice[]
  communicationIdempotencyRecords CommunicationIdempotencyRecord[]
  privacyRequests                 PrivacyRequest[]
  clubMemberships                 ClubMembership[]

  @@map("identity_users")
}

model Identity {
  id                   String           @id @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  provider             IdentityProvider
  // HMAC-SHA256 of the canonical provider subject; ciphertext uses randomized authenticated encryption.
  subjectKey           String           @map("subject_key") @db.Char(64)
  subjectCiphertext    Bytes            @map("subject_ciphertext")
  encryptionKeyVersion Int              @map("encryption_key_version")
  linkedAt             DateTime         @default(now()) @map("linked_at") @db.Timestamptz(3)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, subjectKey], map: "identities_provider_subject_key")
  @@unique([userId, provider], map: "identities_user_provider_key")
  @@map("identities")
}

model Session {
  id                 String              @id @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  authEpoch          Int                 @map("auth_epoch")
  platform           String              @db.VarChar(8)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  idleExpiresAt      DateTime            @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt  DateTime            @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?           @map("revoked_at") @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refreshCredentials RefreshCredential[]
  accessCredentials  AccessCredential[]
  attempts           IdentityAttempt[]

  @@index([userId, revokedAt], map: "identity_sessions_user_idx")
  @@map("identity_sessions")
}

model RefreshCredential {
  id        String    @id @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique(map: "refresh_credentials_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("refresh_credentials")
}

model AccessCredential {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  sessionId String   @map("session_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([expiresAt], map: "access_credentials_expiry_idx")
  @@map("access_credentials")
}

model IdentityAttempt {
  id                         String            @id @db.Uuid
  userId                     String            @map("user_id") @db.Uuid
  sessionId                  String            @map("session_id") @db.Uuid
  action                     String            @db.VarChar(16)
  targetProvider             IdentityProvider? @map("target_provider")
  targetIdentityId           String?           @map("target_identity_id") @db.Uuid
  currentSubjectKey          String?           @map("current_subject_key") @db.Char(64)
  currentProvider            IdentityProvider? @map("current_provider")
  currentProofExpiresAt      DateTime?         @map("current_proof_expires_at") @db.Timestamptz(3)
  targetSubjectKey           String?           @map("target_subject_key") @db.Char(64)
  targetSubjectCiphertext    Bytes?            @map("target_subject_ciphertext")
  targetEncryptionKeyVersion Int?              @map("target_encryption_key_version")
  targetProofExpiresAt       DateTime?         @map("target_proof_expires_at") @db.Timestamptz(3)
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt                  DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt                 DateTime?         @map("consumed_at") @db.Timestamptz(3)
  revokedAt                  DateTime?         @map("revoked_at") @db.Timestamptz(3)
  user                       User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session                    Session           @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  magicLinks                 MagicLink[]

  @@index([userId, expiresAt], map: "identity_attempts_user_expiry_idx")
  @@map("identity_attempts")
}

model MagicLink {
  id                   String           @id @db.Uuid
  userId               String?          @map("user_id") @db.Uuid
  attemptId            String?          @map("attempt_id") @db.Uuid
  purpose              String           @db.VarChar(16)
  side                 String?          @db.VarChar(8)
  // Scope = HMAC(address + purpose + attempt + side), not exposed outside identity storage.
  scopeKey             String           @map("scope_key") @db.Char(64)
  subjectKey           String           @map("subject_key") @db.Char(64)
  subjectCiphertext    Bytes            @map("subject_ciphertext")
  encryptionKeyVersion Int              @map("encryption_key_version")
  tokenHash            String           @unique(map: "magic_links_token_hash_key") @map("token_hash") @db.Char(64)
  clientPlatform       String?          @map("client_platform") @db.VarChar(8)
  nativeCodeChallenge  String?          @map("native_code_challenge") @db.Char(43)
  mobileDestination    Json?            @map("mobile_destination")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt           DateTime?        @map("consumed_at") @db.Timestamptz(3)
  revokedAt            DateTime?        @map("revoked_at") @db.Timestamptz(3)
  user                 User?            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempt              IdentityAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt], map: "magic_links_expiry_idx")
  @@map("magic_links")
}

model TelegramProofReplay {
  fingerprint String   @id @db.Char(64)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt], map: "telegram_proof_replays_expiry_idx")
  @@map("telegram_proof_replays")
}

model ConsentDocument {
  purpose     ConsentPurpose
  version     String         @db.VarChar(128)
  checksum    String         @db.Char(64)
  title       String         @db.VarChar(200)
  text        String
  effectiveAt DateTime       @map("effective_at") @db.Timestamptz(3)
  isCurrent   Boolean        @default(false) @map("is_current")
  consents    Consent[]

  @@id([purpose, version])
  @@map("consent_documents")
}

model Consent {
  id          String          @id @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  purpose     ConsentPurpose
  version     String          @db.VarChar(128)
  action      ConsentAction
  platform    String          @db.VarChar(8)
  operationId String          @map("operation_id") @db.Uuid
  occurredAt  DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(3)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document    ConsentDocument @relation(fields: [purpose, version], references: [purpose, version], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, operationId], map: "consents_user_operation_key")
  @@index([userId, occurredAt, id], map: "consents_user_history_idx")
  @@map("consents")
}

model OnboardingLocality {
  id               String               @id @db.Uuid
  name             String               @db.VarChar(120)
  countryCode      String               @map("country_code") @db.Char(2)
  region           String               @db.VarChar(120)
  catalogueVersion Int                  @map("catalogue_version")
  drafts           PlayerProfileDraft[]

  @@map("onboarding_localities")
}

model PlayerProfileDraft {
  userId              String              @id @map("user_id") @db.Uuid
  version             Int                 @default(0)
  displayName         String?             @map("display_name") @db.VarChar(50)
  timeZone            String?             @map("time_zone") @db.VarChar(64)
  localityId          String?             @map("locality_id") @db.Uuid
  gameFormats         String[]            @default([]) @map("game_formats")
  skillSelfAssessment Decimal?            @map("skill_self_assessment") @db.Decimal(2, 1)
  duprProfileUrl      String?             @map("dupr_profile_url") @db.VarChar(2048)
  completedAt         DateTime?           @map("completed_at") @db.Timestamptz(3)
  updatedAt           DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)
  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locality            OnboardingLocality? @relation(fields: [localityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("player_profile_drafts")
}

model IdentityIdempotencyRecord {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(160)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, method, canonicalPath, idempotencyKey], map: "identity_idempotency_scope_key")
  @@index([expiresAt], map: "identity_idempotency_expiry_idx")
  @@map("identity_idempotency_records")
}

// Venues data contract. Geography, GiST indexes, partial uniqueness, transition guards and immutable history
// are maintained by the SQL migration because Prisma 6 cannot express them completely.
enum VenuePublicationState {
  PUBLISHED
  PRIVACY_REVIEW
  CLOSED
  MERGED

  @@map("venue_publication_state")
}

enum VenueVerificationState {
  IMPORTED_UNREVIEWED
  COMMUNITY_CONFIRMED
  MODERATOR_VERIFIED
  STALE

  @@map("venue_verification_state")
}

enum VenueAccessMode {
  FREE
  PAID
  REGISTRATION_REQUIRED
  MEMBERS_ONLY
  UNKNOWN

  @@map("venue_access_mode")
}

enum VenueEnvironment {
  INDOOR
  OUTDOOR
  MIXED
  UNKNOWN

  @@map("venue_environment")
}

enum VenueAmenityState {
  YES
  NO
  UNKNOWN

  @@map("venue_amenity_state")
}

enum VenueCandidateState {
  MATCH_ONLY
  AWAITING_MATCH_COMPLETION
  PENDING_REVIEW
  APPROVED
  REJECTED
  MERGED
  WITHDRAWN

  @@map("venue_candidate_state")
}

enum VenueContributionState {
  PENDING_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN

  @@map("venue_contribution_state")
}

enum VenueReportReason {
  PRIVATE_RESIDENCE
  DUPLICATE
  CLOSED

  @@map("venue_report_reason")
}

enum VenueReportState {
  PENDING_REVIEW
  RESOLVED
  REJECTED

  @@map("venue_report_state")
}

enum VenueSourceKind {
  OPENSTREETMAP
  GEOCODER
  COMMUNITY
  MODERATOR

  @@map("venue_source_kind")
}

enum VenueModerationSubject {
  CANDIDATE
  REVISION
  REPORT
  VENUE

  @@map("venue_moderation_subject")
}

enum VenueModerationOutcome {
  APPROVED
  REJECTED
  MERGED
  WITHDRAWN

  @@map("venue_moderation_outcome")
}

model Venue {
  id                   String                                @id @db.Uuid
  name                 String                                @db.VarChar(160)
