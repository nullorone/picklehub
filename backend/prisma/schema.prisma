generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  QUARANTINED

  @@map("outbox_status")
}

model OutboxEvent {
  id            String       @id @db.Uuid
  type          String       @db.VarChar(160)
  schemaVersion Int          @map("schema_version")
  payload       Json
  correlationId String       @map("correlation_id") @db.Uuid
  causationId   String?      @map("causation_id") @db.Uuid
  occurredAt    DateTime     @map("occurred_at") @db.Timestamptz(3)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  claimedAt     DateTime?    @map("claimed_at") @db.Timestamptz(3)
  claimedBy     String?      @map("claimed_by") @db.Uuid
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  lastErrorCode String?      @map("last_error_code") @db.VarChar(96)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt, occurredAt], map: "outbox_events_dispatch_idx")
  @@map("outbox_events")
}

model AuditEntry {
  id            String   @id @db.Uuid
  actorType     String   @map("actor_type") @db.VarChar(64)
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(160)
  targetType    String   @map("target_type") @db.VarChar(96)
  targetId      String?  @map("target_id") @db.Uuid
  outcome       String   @db.VarChar(48)
  reasonCode    String?  @map("reason_code") @db.VarChar(96)
  changedFields Json     @map("changed_fields")
  requestId     String   @map("request_id") @db.Uuid
  correlationId String   @map("correlation_id") @db.Uuid
  source        String   @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt], map: "audit_entries_target_idx")
  @@index([actorId, createdAt], map: "audit_entries_actor_idx")
  @@map("audit_entries")
}

// Identity data contract. SQL migration also owns CHECKs, partial indexes and deferred triggers.
enum IdentityProvider {
  TELEGRAM
  EMAIL

  @@map("identity_provider")
}

enum UserStatus {
  ACTIVE
  DELETION_PENDING
  DELETED

  @@map("identity_user_status")
}

enum ConsentPurpose {
  TERMS
  PERSONAL_DATA
  ANALYTICS
  MARKETING

  @@map("consent_purpose")
}

enum ConsentAction {
  ACCEPTED
  WITHDRAWN

  @@map("consent_action")
}

model User {
  id                  String                      @id @db.Uuid
  status              UserStatus                  @default(ACTIVE)
  authEpoch           Int                         @default(0) @map("auth_epoch")
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt         DateTime                    @default(now()) @map("last_login_at") @db.Timestamptz(3)
  completedAt         DateTime?                   @map("completed_at") @db.Timestamptz(3)
  deletionRequestedAt DateTime?                   @map("deletion_requested_at") @db.Timestamptz(3)
  deletedAt           DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  identities          Identity[]
  sessions            Session[]
  draft               PlayerProfileDraft?
  consents            Consent[]
  attempts            IdentityAttempt[]
  magicLinks          MagicLink[]
  idempotencyRecords  IdentityIdempotencyRecord[]
  venueCandidates     VenueCandidate[]
  venueRevisions      VenueRevision[]
  venueReports        VenueReport[]
  venueSources        VenueSource[]
  venueDecisions      VenueModerationDecision[]
  organizedMatches    Match[]                    @relation("MatchOrganizer")
  matchParticipants   MatchParticipant[]
  matchGuestOwners    MatchGuestSlot[]
  matchJoinRequests   JoinRequest[]
  matchWaitlist       WaitlistEntry[]
  resultProposals     MatchResult[]               @relation("MatchResultProposer")
  resultConfirmations ResultConfirmation[]

  @@map("identity_users")
}

model Identity {
  id                   String           @id @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  provider             IdentityProvider
  // HMAC-SHA256 of the canonical provider subject; ciphertext uses randomized authenticated encryption.
  subjectKey           String           @map("subject_key") @db.Char(64)
  subjectCiphertext    Bytes            @map("subject_ciphertext")
  encryptionKeyVersion Int              @map("encryption_key_version")
  linkedAt             DateTime         @default(now()) @map("linked_at") @db.Timestamptz(3)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, subjectKey], map: "identities_provider_subject_key")
  @@unique([userId, provider], map: "identities_user_provider_key")
  @@map("identities")
}

model Session {
  id                 String              @id @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  authEpoch          Int                 @map("auth_epoch")
  platform           String              @db.VarChar(8)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  idleExpiresAt      DateTime            @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt  DateTime            @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?           @map("revoked_at") @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refreshCredentials RefreshCredential[]
  accessCredentials  AccessCredential[]
  attempts           IdentityAttempt[]

  @@index([userId, revokedAt], map: "identity_sessions_user_idx")
  @@map("identity_sessions")
}

model RefreshCredential {
  id        String    @id @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique(map: "refresh_credentials_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("refresh_credentials")
}

model AccessCredential {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  sessionId String   @map("session_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([expiresAt], map: "access_credentials_expiry_idx")
  @@map("access_credentials")
}

model IdentityAttempt {
  id                         String            @id @db.Uuid
  userId                     String            @map("user_id") @db.Uuid
  sessionId                  String            @map("session_id") @db.Uuid
  action                     String            @db.VarChar(16)
  targetProvider             IdentityProvider? @map("target_provider")
  targetIdentityId           String?           @map("target_identity_id") @db.Uuid
  currentSubjectKey          String?           @map("current_subject_key") @db.Char(64)
  currentProvider            IdentityProvider? @map("current_provider")
  currentProofExpiresAt      DateTime?         @map("current_proof_expires_at") @db.Timestamptz(3)
  targetSubjectKey           String?           @map("target_subject_key") @db.Char(64)
  targetSubjectCiphertext    Bytes?            @map("target_subject_ciphertext")
  targetEncryptionKeyVersion Int?              @map("target_encryption_key_version")
  targetProofExpiresAt       DateTime?         @map("target_proof_expires_at") @db.Timestamptz(3)
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt                  DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt                 DateTime?         @map("consumed_at") @db.Timestamptz(3)
  revokedAt                  DateTime?         @map("revoked_at") @db.Timestamptz(3)
  user                       User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session                    Session           @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  magicLinks                 MagicLink[]

  @@index([userId, expiresAt], map: "identity_attempts_user_expiry_idx")
  @@map("identity_attempts")
}

model MagicLink {
  id                   String           @id @db.Uuid
  userId               String?          @map("user_id") @db.Uuid
  attemptId            String?          @map("attempt_id") @db.Uuid
  purpose              String           @db.VarChar(16)
  side                 String?          @db.VarChar(8)
  // Scope = HMAC(address + purpose + attempt + side), not exposed outside identity storage.
  scopeKey             String           @map("scope_key") @db.Char(64)
  subjectKey           String           @map("subject_key") @db.Char(64)
  subjectCiphertext    Bytes            @map("subject_ciphertext")
  encryptionKeyVersion Int              @map("encryption_key_version")
  tokenHash            String           @unique(map: "magic_links_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt           DateTime?        @map("consumed_at") @db.Timestamptz(3)
  revokedAt            DateTime?        @map("revoked_at") @db.Timestamptz(3)
  user                 User?            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempt              IdentityAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt], map: "magic_links_expiry_idx")
  @@map("magic_links")
}

model TelegramProofReplay {
  fingerprint String   @id @db.Char(64)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt], map: "telegram_proof_replays_expiry_idx")
  @@map("telegram_proof_replays")
}

model ConsentDocument {
  purpose     ConsentPurpose
  version     String         @db.VarChar(128)
  checksum    String         @db.Char(64)
  title       String         @db.VarChar(200)
  text        String
  effectiveAt DateTime       @map("effective_at") @db.Timestamptz(3)
  isCurrent   Boolean        @default(false) @map("is_current")
  consents    Consent[]

  @@id([purpose, version])
  @@map("consent_documents")
}

model Consent {
  id          String          @id @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  purpose     ConsentPurpose
  version     String          @db.VarChar(128)
  action      ConsentAction
  platform    String          @db.VarChar(8)
  operationId String          @map("operation_id") @db.Uuid
  occurredAt  DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(3)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document    ConsentDocument @relation(fields: [purpose, version], references: [purpose, version], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, operationId], map: "consents_user_operation_key")
  @@index([userId, occurredAt, id], map: "consents_user_history_idx")
  @@map("consents")
}

model OnboardingLocality {
  id               String               @id @db.Uuid
  name             String               @db.VarChar(120)
  countryCode      String               @map("country_code") @db.Char(2)
  region           String               @db.VarChar(120)
  catalogueVersion Int                  @map("catalogue_version")
  drafts           PlayerProfileDraft[]

  @@map("onboarding_localities")
}

model PlayerProfileDraft {
  userId              String              @id @map("user_id") @db.Uuid
  version             Int                 @default(0)
  displayName         String?             @map("display_name") @db.VarChar(50)
  timeZone            String?             @map("time_zone") @db.VarChar(64)
  localityId          String?             @map("locality_id") @db.Uuid
  gameFormats         String[]            @default([]) @map("game_formats")
  skillSelfAssessment Decimal?            @map("skill_self_assessment") @db.Decimal(2, 1)
  duprProfileUrl      String?             @map("dupr_profile_url") @db.VarChar(2048)
  completedAt         DateTime?           @map("completed_at") @db.Timestamptz(3)
  updatedAt           DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)
  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locality            OnboardingLocality? @relation(fields: [localityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("player_profile_drafts")
}

model IdentityIdempotencyRecord {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(160)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, method, canonicalPath, idempotencyKey], map: "identity_idempotency_scope_key")
  @@index([expiresAt], map: "identity_idempotency_expiry_idx")
  @@map("identity_idempotency_records")
}

// Venues data contract. Geography, GiST indexes, partial uniqueness, transition guards and immutable history
// are maintained by the SQL migration because Prisma 6 cannot express them completely.
enum VenuePublicationState {
  PUBLISHED
  PRIVACY_REVIEW
  CLOSED
  MERGED

  @@map("venue_publication_state")
}

enum VenueVerificationState {
  IMPORTED_UNREVIEWED
  COMMUNITY_CONFIRMED
  MODERATOR_VERIFIED
  STALE

  @@map("venue_verification_state")
}

enum VenueAccessMode {
  FREE
  PAID
  REGISTRATION_REQUIRED
  MEMBERS_ONLY
  UNKNOWN

  @@map("venue_access_mode")
}

enum VenueEnvironment {
  INDOOR
  OUTDOOR
  MIXED
  UNKNOWN

  @@map("venue_environment")
}

enum VenueAmenityState {
  YES
  NO
  UNKNOWN

  @@map("venue_amenity_state")
}

enum VenueCandidateState {
  MATCH_ONLY
  AWAITING_MATCH_COMPLETION
  PENDING_REVIEW
  APPROVED
  REJECTED
  MERGED
  WITHDRAWN

  @@map("venue_candidate_state")
}

enum VenueContributionState {
  PENDING_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN

  @@map("venue_contribution_state")
}

enum VenueReportReason {
  PRIVATE_RESIDENCE
  DUPLICATE
  CLOSED

  @@map("venue_report_reason")
}

enum VenueReportState {
  PENDING_REVIEW
  RESOLVED
  REJECTED

  @@map("venue_report_state")
}

enum VenueSourceKind {
  OPENSTREETMAP
  GEOCODER
  COMMUNITY
  MODERATOR

  @@map("venue_source_kind")
}

enum VenueModerationSubject {
  CANDIDATE
  REVISION
  REPORT
  VENUE

  @@map("venue_moderation_subject")
}

enum VenueModerationOutcome {
  APPROVED
  REJECTED
  MERGED
  WITHDRAWN

  @@map("venue_moderation_outcome")
}

model Venue {
  id                       String                   @id @db.Uuid
  name                     String                   @db.VarChar(160)
  normalizedAddress        String                   @map("normalized_address") @db.VarChar(500)
  searchDocument           Unsupported("tsvector")  @default(dbgenerated()) @map("search_document")
  locality                 String                   @db.VarChar(160)
  timeZone                 String                   @map("time_zone") @db.VarChar(64)
  longitude                Decimal                  @db.Decimal(9, 6)
  latitude                 Decimal                  @db.Decimal(8, 6)
  location                 Unsupported("geography(Point, 4326)") @default(dbgenerated())
  publicationState         VenuePublicationState    @default(PUBLISHED) @map("publication_state")
  verificationState        VenueVerificationState   @map("verification_state")
  accessMode               VenueAccessMode          @default(UNKNOWN) @map("access_mode")
  environment              VenueEnvironment         @default(UNKNOWN)
  pickleballCourtCount     Int?                     @map("pickleball_court_count") @db.SmallInt
  surfaceType              String?                  @map("surface_type") @db.VarChar(120)
  permanentNet             VenueAmenityState        @default(UNKNOWN) @map("permanent_net")
  lighting                 VenueAmenityState        @default(UNKNOWN)
  changingRoom             VenueAmenityState        @default(UNKNOWN) @map("changing_room")
  toilet                   VenueAmenityState        @default(UNKNOWN)
  drinkingWater            VenueAmenityState        @default(UNKNOWN) @map("drinking_water")
  parking                  VenueAmenityState        @default(UNKNOWN)
  wheelchairAccess         VenueAmenityState        @default(UNKNOWN) @map("wheelchair_access")
  openingHours             Json?                    @map("opening_hours")
  seasonality              String?                  @db.VarChar(500)
  closedUntil              DateTime?                @map("closed_until") @db.Timestamptz(3)
  version                  Int                      @default(1)
  lastVerifiedAt           DateTime                 @map("last_verified_at") @db.Timestamptz(3)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(3)
  canonicalVenueId         String?                  @map("canonical_venue_id") @db.Uuid
  canonicalVenue           Venue?                   @relation("VenueCanonical", fields: [canonicalVenueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mergedAliases            Venue[]                  @relation("VenueCanonical")
  sources                  VenueSource[]
  candidates               VenueCandidate[]
  revisions                VenueRevision[]
  reports                  VenueReport[]
  decisions                VenueModerationDecision[]
  previousMerges           VenueMerge[]             @relation("VenueMergePrevious")
  canonicalMerges          VenueMerge[]             @relation("VenueMergeCanonical")
  matches                  Match[]

  @@index([publicationState, name, id], map: "venues_catalogue_sort_idx")
  @@index([publicationState, lastVerifiedAt], map: "venues_staleness_idx")
  @@map("venues")
}

model VenueCandidate {
  id                       String                 @id @db.Uuid
  sourceMatchId            String                 @unique(map: "venue_candidates_source_match_key") @map("source_match_id") @db.Uuid
  contributorId            String                 @map("contributor_id") @db.Uuid
  name                     String                 @db.VarChar(160)
  normalizedAddress        String                 @map("normalized_address") @db.VarChar(500)
  locality                 String                 @db.VarChar(160)
  timeZone                 String                 @map("time_zone") @db.VarChar(64)
  longitude                Decimal                @db.Decimal(9, 6)
  latitude                 Decimal                @db.Decimal(8, 6)
  location                 Unsupported("geography(Point, 4326)") @default(dbgenerated())
  state                    VenueCandidateState    @default(AWAITING_MATCH_COMPLETION)
  qualifiedAt              DateTime?              @map("qualified_at") @db.Timestamptz(3)
  canonicalVenueId         String?                @map("canonical_venue_id") @db.Uuid
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt                DateTime?              @map("decided_at") @db.Timestamptz(3)
  contributor              User                   @relation(fields: [contributorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonicalVenue           Venue?                 @relation(fields: [canonicalVenueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sources                  VenueSource[]
  decisions                VenueModerationDecision[]
  matches                  Match[]

  @@index([state, qualifiedAt, id], map: "venue_candidates_review_idx")
  @@map("venue_candidates")
}

model VenueRevision {
  id              String                 @id @db.Uuid
  venueId         String                 @map("venue_id") @db.Uuid
  contributorId   String                 @map("contributor_id") @db.Uuid
  baseVersion     Int                    @map("base_version")
  proposedData    Json                   @map("proposed_data")
  changedFields   String[]               @map("changed_fields")
  state           VenueContributionState @default(PENDING_REVIEW)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt       DateTime?              @map("decided_at") @db.Timestamptz(3)
  venue           Venue                  @relation(fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contributor     User                   @relation(fields: [contributorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sources         VenueSource[]
  decisions       VenueModerationDecision[]

  @@index([venueId, state, createdAt, id], map: "venue_revisions_review_idx")
  @@map("venue_revisions")
}

model VenueReport {
  id          String            @id @db.Uuid
  venueId     String            @map("venue_id") @db.Uuid
  reporterId  String            @map("reporter_id") @db.Uuid
  reason      VenueReportReason
  state       VenueReportState  @default(PENDING_REVIEW)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt  DateTime?         @map("resolved_at") @db.Timestamptz(3)
  venue       Venue             @relation(fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reporter    User              @relation(fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decisions   VenueModerationDecision[]

  @@index([venueId, state, createdAt, id], map: "venue_reports_review_idx")
  @@map("venue_reports")
}

model VenueSource {
  id                       String          @id @db.Uuid
  venueId                  String?         @map("venue_id") @db.Uuid
  candidateId              String?         @map("candidate_id") @db.Uuid
  revisionId               String?         @map("revision_id") @db.Uuid
  kind                     VenueSourceKind
  providerKey              String?         @map("provider_key") @db.VarChar(80)
  externalSourceId         String?         @map("external_source_id") @db.VarChar(300)
  externalSourceVersion    String?         @map("external_source_version") @db.VarChar(160)
  importBatchId            String?         @map("import_batch_id") @db.Uuid
  contributorId            String?         @map("contributor_id") @db.Uuid
  contributorAgreement     String?         @map("contributor_agreement") @db.VarChar(128)
  observedAt               DateTime        @map("observed_at") @db.Timestamptz(3)
  license                  String          @db.VarChar(160)
  policyVersion            String          @map("policy_version") @db.VarChar(128)
  storageAllowed           Boolean         @map("storage_allowed")
  allowedFields            String[]        @map("allowed_fields")
  attributionText          String          @map("attribution_text") @db.VarChar(300)
  attributionLink          String?         @map("attribution_link") @db.VarChar(2048)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  venue                    Venue?          @relation(fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidate                VenueCandidate? @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision                 VenueRevision?  @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contributor              User?           @relation(fields: [contributorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([venueId, observedAt], map: "venue_sources_venue_idx")
  @@index([candidateId, observedAt], map: "venue_sources_candidate_idx")
  @@index([revisionId, observedAt], map: "venue_sources_revision_idx")
  @@map("venue_sources")
}

model VenueModerationDecision {
  id            String                   @id @db.Uuid
  subject       VenueModerationSubject
  candidateId   String?                  @map("candidate_id") @db.Uuid
  revisionId    String?                  @map("revision_id") @db.Uuid
  reportId      String?                  @map("report_id") @db.Uuid
  venueId       String?                  @map("venue_id") @db.Uuid
  moderatorId   String                   @map("moderator_id") @db.Uuid
  outcome       VenueModerationOutcome
  reasonCode    String                   @map("reason_code") @db.VarChar(96)
  decidedAt     DateTime                 @default(now()) @map("decided_at") @db.Timestamptz(3)
  candidate     VenueCandidate?          @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision      VenueRevision?           @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  report        VenueReport?             @relation(fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue         Venue?                   @relation(fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  moderator     User                     @relation(fields: [moderatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merges        VenueMerge[]

  @@map("venue_moderation_decisions")
}

model VenueMerge {
  id               String                    @id @db.Uuid
  previousVenueId  String                    @map("previous_venue_id") @db.Uuid
  canonicalVenueId String                    @map("canonical_venue_id") @db.Uuid
  decisionId       String                    @unique(map: "venue_merges_decision_key") @map("decision_id") @db.Uuid
  reasonCode       String                    @map("reason_code") @db.VarChar(96)
  mergedAt         DateTime                  @default(now()) @map("merged_at") @db.Timestamptz(3)
  previousVenue    Venue                     @relation("VenueMergePrevious", fields: [previousVenueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonicalVenue   Venue                     @relation("VenueMergeCanonical", fields: [canonicalVenueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decision         VenueModerationDecision   @relation(fields: [decisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([previousVenueId, canonicalVenueId], map: "venue_merges_pair_key")
  @@index([canonicalVenueId, mergedAt], map: "venue_merges_canonical_idx")
  @@map("venue_merges")
}

model VenueIdempotencyRecord {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(160)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)

  @@unique([userId, method, canonicalPath, idempotencyKey], map: "venue_idempotency_scope_key")
  @@index([expiresAt], map: "venue_idempotency_expiry_idx")
  @@map("venue_idempotency_records")
}

enum VenueImportStatus {
  RUNNING
  COMPLETED
  FAILED

  @@map("venue_import_status")
}

model VenueImportRun {
  id                String            @id @db.Uuid
  providerKey       String            @map("provider_key") @db.VarChar(80)
  sourceVersion     String            @map("source_version") @db.VarChar(160)
  scopeKey          String            @map("scope_key") @db.VarChar(160)
  dryRun            Boolean           @map("dry_run")
  status            VenueImportStatus @default(RUNNING)
  checkpoint        Json              @default("{\"offset\":0}")
  scannedCount      Int               @default(0) @map("scanned_count")
  createdCount      Int               @default(0) @map("created_count")
  deduplicatedCount Int               @default(0) @map("deduplicated_count")
  quarantinedCount  Int               @default(0) @map("quarantined_count")
  failureCode       String?           @map("failure_code") @db.VarChar(96)
  startedAt         DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?         @map("finished_at") @db.Timestamptz(3)

  @@index([providerKey, scopeKey, status, startedAt], map: "venue_import_runs_resume_idx")
  @@map("venue_import_runs")
}

model VenueImportCheckpoint {
  providerKey   String   @map("provider_key") @db.VarChar(80)
  scopeKey      String   @map("scope_key") @db.VarChar(160)
  sourceVersion String   @map("source_version") @db.VarChar(160)
  checkpoint    Json
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([providerKey, scopeKey])
  @@map("venue_import_checkpoints")
}

// Matches data contract. Cross-table capacity, active-involvement, state-pair and immutable-outcome rules are
// enforced by the SQL migration with deferred constraint triggers and row-level serialization on matches.
enum MatchFormat {
  SINGLES
  DOUBLES

  @@map("match_format")
}

enum MatchVisibility {
  PUBLIC
  UNLISTED

  @@map("match_visibility")
}

enum MatchJoinMode {
  AUTO
  APPROVAL

  @@map("match_join_mode")
}

enum MatchState {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  DISPUTED
  CANCELLED
  COMPLETED
  VOIDED

  @@map("match_state")
}

enum MatchTeamCode {
  TEAM_A
  TEAM_B

  @@map("match_team_code")
}

enum MatchTeamChoice {
  TEAM_A
  TEAM_B
  ANY

  @@map("match_team_choice")
}

enum MatchParticipantState {
  ACTIVE
  LEFT
  CANCELLED
  PLAYED

  @@map("match_participant_state")
}

enum MatchJoinRequestState {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED

  @@map("match_join_request_state")
}

enum MatchWaitlistState {
  WAITING
  OFFERED
  PROMOTED
  WITHDRAWN
  SKIPPED
  EXPIRED

  @@map("match_waitlist_state")
}

enum MatchResultState {
  PROPOSED
  SUPERSEDED
  CONFIRMED
  DISPUTED
  VOIDED

  @@map("match_result_state")
}

enum MatchResultMode {
  SCORED
  PLAYED_WITHOUT_SCORE

  @@map("match_result_mode")
}

enum MatchSeriesFormat {
  BEST_OF_1
  BEST_OF_3
  BEST_OF_5

  @@map("match_series_format")
}

enum ResultConfirmationDecision {
  CONFIRMED
  DISPUTED

  @@map("result_confirmation_decision")
}

enum MatchMetricType {
  CONFIRMED_MATCH

  @@map("match_metric_type")
}

enum ExternalBookingState {
  UNKNOWN
  NOT_BOOKED
  BOOKED_EXTERNALLY

  @@map("external_booking_state")
}

model Match {
  id                       String                 @id @db.Uuid
  organizerId              String                 @map("organizer_id") @db.Uuid
  version                  Int                    @default(0)
  state                    MatchState             @default(DRAFT)
  format                   MatchFormat?
  visibility               MatchVisibility?
  joinMode                 MatchJoinMode?         @map("join_mode")
  startsAt                 DateTime?              @map("starts_at") @db.Timestamptz(3)
  timeZone                 String?                @map("time_zone") @db.VarChar(64)
  venueId                  String?                @map("venue_id") @db.Uuid
  venueCandidateId         String?                @map("venue_candidate_id") @db.Uuid
  skillMin                 Decimal?               @map("skill_min") @db.Decimal(2, 1)
  skillMax                 Decimal?               @map("skill_max") @db.Decimal(2, 1)
  description              String?                @db.VarChar(1000)
  bookingState             ExternalBookingState   @default(UNKNOWN) @map("booking_state")
  bookingNote              String?                @map("booking_note") @db.VarChar(280)
  policyVersion            String?                @map("policy_version") @db.VarChar(64)
  waitlistSequence         BigInt                 @default(0) @map("waitlist_sequence")
  rosterCompletionSequence Int                    @default(0) @map("roster_completion_sequence")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt              DateTime?              @map("published_at") @db.Timestamptz(3)
  updatedAt                DateTime               @default(now()) @map("updated_at") @db.Timestamptz(3)
  organizer                User                   @relation("MatchOrganizer", fields: [organizerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                    Venue?                 @relation(fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venueCandidate           VenueCandidate?        @relation(fields: [venueCandidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teams                    MatchTeam[]
  participants             MatchParticipant[]
  guests                   MatchGuestSlot[]
  joinRequests             JoinRequest[]
  waitlistEntries          WaitlistEntry[]
  invites                  MatchInvite[]
  results                  MatchResult[]
  metricMarkers            MatchMetricMarker[]
  idempotencyRecords       MatchIdempotencyRecord[]

  @@index([visibility, state, startsAt, id], map: "matches_public_search_idx")
  @@index([organizerId, state, updatedAt], map: "matches_organizer_idx")
  @@map("matches")
}

model MatchTeam {
  matchId   String        @map("match_id") @db.Uuid
  code      MatchTeamCode
  capacity  Int           @db.SmallInt
  match     Match         @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([matchId, code])
  @@map("match_teams")
}

model MatchParticipant {
  id          String                @id @db.Uuid
  matchId     String                @map("match_id") @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  team        MatchTeamCode
  state       MatchParticipantState @default(ACTIVE)
  isOrganizer Boolean               @default(false) @map("is_organizer")
  joinedAt    DateTime              @default(now()) @map("joined_at") @db.Timestamptz(3)
  resolvedAt  DateTime?             @map("resolved_at") @db.Timestamptz(3)
  match       Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([matchId, userId], map: "match_participants_match_user_key")
  @@index([matchId, state, team], map: "match_participants_roster_idx")
  @@map("match_participants")
}

model MatchGuestSlot {
  id        String        @id @db.Uuid
  matchId   String        @map("match_id") @db.Uuid
  team      MatchTeamCode
  label     String        @db.VarChar(50)
  createdBy String        @map("created_by") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  match     Match         @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  owner     User          @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([matchId, team], map: "match_guest_slots_team_idx")
  @@map("match_guest_slots")
}

model JoinRequest {
  id          String                @id @db.Uuid
  matchId     String                @map("match_id") @db.Uuid
  requesterId String                @map("requester_id") @db.Uuid
  teamChoice  MatchTeamChoice       @map("team_choice")
  state       MatchJoinRequestState @default(PENDING)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt   DateTime?             @map("decided_at") @db.Timestamptz(3)
  match       Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  requester   User                  @relation(fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([matchId, state, createdAt, id], map: "join_requests_pending_idx")
  @@map("join_requests")
}

model WaitlistEntry {
  id             String             @id @db.Uuid
  matchId        String             @map("match_id") @db.Uuid
  playerId       String             @map("player_id") @db.Uuid
  teamChoice     MatchTeamChoice    @map("team_choice")
  state          MatchWaitlistState @default(WAITING)
  sequence       BigInt
  offeredTeam    MatchTeamCode?     @map("offered_team")
  offeredAt      DateTime?          @map("offered_at") @db.Timestamptz(3)
  offerExpiresAt DateTime?          @map("offer_expires_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt     DateTime?          @map("resolved_at") @db.Timestamptz(3)
  match          Match              @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  player         User               @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([matchId, sequence], map: "waitlist_entries_match_sequence_key")
  @@index([matchId, state, sequence], map: "waitlist_entries_fifo_idx")
  @@map("waitlist_entries")
}

model MatchInvite {
  id         String   @id @db.Uuid
  matchId    String   @map("match_id") @db.Uuid
  version    Int
  tokenHash  String   @map("token_hash") @db.Char(64)
  keyVersion Int      @map("key_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([matchId, version], map: "match_invites_match_version_key")
  @@unique([tokenHash], map: "match_invites_token_hash_key")
  @@map("match_invites")
}

model MatchResult {
  id            String            @id @db.Uuid
  matchId       String            @map("match_id") @db.Uuid
  version       Int
  state         MatchResultState  @default(PROPOSED)
  mode          MatchResultMode
  seriesFormat  MatchSeriesFormat? @map("series_format")
  winningTeam   MatchTeamCode?    @map("winning_team")
  proposedBy    String            @map("proposed_by") @db.Uuid
  proposedAt    DateTime          @default(now()) @map("proposed_at") @db.Timestamptz(3)
  resolvedAt    DateTime?         @map("resolved_at") @db.Timestamptz(3)
  match         Match             @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  proposer      User              @relation("MatchResultProposer", fields: [proposedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  games         GameScore[]
  confirmations ResultConfirmation[]
  metricMarkers MatchMetricMarker[]

  @@unique([matchId, version], map: "match_results_match_version_key")
  @@index([matchId, state], map: "match_results_current_idx")
  @@map("match_results")
}

model GameScore {
  resultId    String      @map("result_id") @db.Uuid
  gameNumber Int         @map("game_number") @db.SmallInt
  teamAPoints Int        @map("team_a_points") @db.SmallInt
  teamBPoints Int        @map("team_b_points") @db.SmallInt
  result      MatchResult @relation(fields: [resultId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([resultId, gameNumber])
  @@map("game_scores")
}

model ResultConfirmation {
  id        String                     @id @db.Uuid
  resultId  String                     @map("result_id") @db.Uuid
  playerId  String                     @map("player_id") @db.Uuid
  decision  ResultConfirmationDecision
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  result    MatchResult                @relation(fields: [resultId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  player    User                       @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([resultId, playerId], map: "result_confirmations_result_player_key")
  @@map("result_confirmations")
}

model MatchMetricMarker {
  id               String          @id @db.Uuid
  matchId          String          @map("match_id") @db.Uuid
  resultId         String          @map("result_id") @db.Uuid
  metricType       MatchMetricType @map("metric_type")
  confirmationPath String          @map("confirmation_path") @db.VarChar(16)
  confirmedAt      DateTime        @map("confirmed_at") @db.Timestamptz(3)
  match            Match           @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  result           MatchResult     @relation(fields: [resultId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([matchId, metricType], map: "match_metric_markers_effective_key")
  @@unique([resultId, metricType], map: "match_metric_markers_result_key")
  @@map("match_metric_markers")
}

model MatchIdempotencyRecord {
  id                   String   @id @db.Uuid
  matchId              String?  @map("match_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(200)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)
  match                Match?   @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([userId, method, canonicalPath, idempotencyKey], map: "match_idempotency_scope_key")
  @@index([expiresAt], map: "match_idempotency_expiry_idx")
  @@map("match_idempotency_records")
}
