  @@unique([resultId, playerId], map: "result_confirmations_result_player_key")
  @@map("result_confirmations")
}

model MatchMetricMarker {
  id               String          @id @db.Uuid
  matchId          String          @map("match_id") @db.Uuid
  resultId         String          @map("result_id") @db.Uuid
  metricType       MatchMetricType @map("metric_type")
  confirmationPath String          @map("confirmation_path") @db.VarChar(16)
  confirmedAt      DateTime        @map("confirmed_at") @db.Timestamptz(3)
  match            Match           @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  result           MatchResult     @relation(fields: [resultId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([matchId, metricType], map: "match_metric_markers_effective_key")
  @@unique([resultId, metricType], map: "match_metric_markers_result_key")
  @@map("match_metric_markers")
}

model MatchIdempotencyRecord {
  id                   String   @id @db.Uuid
  matchId              String?  @map("match_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(200)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)
  match                Match?   @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([userId, method, canonicalPath, idempotencyKey], map: "match_idempotency_scope_key")
  @@index([expiresAt], map: "match_idempotency_expiry_idx")
  @@map("match_idempotency_records")
}

model MatchStatisticsReceipt {
  consumerKey String   @map("consumer_key") @db.VarChar(80)
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumerKey, eventId])
  @@map("match_statistics_receipts")
}

model PlayerMatchStatistic {
  userId          String   @id @map("user_id") @db.Uuid
  playedCount     Int      @default(0) @map("played_count")
  winsCount       Int      @default(0) @map("wins_count")
  lossesCount     Int      @default(0) @map("losses_count")
  lastConfirmedAt DateTime @map("last_confirmed_at") @db.Timestamptz(3)

  @@map("player_match_statistics")
}

// Profiles data contract. SQL owns cross-row generation activation, immutable source revisions and aggregate
// consistency checks that Prisma cannot express completely. PlayerMatchStatistic above is a legacy match-module
// projection and is not the canonical profile statistics source.
enum ProfileVisibility {
  PUBLIC
  PRIVATE

  @@map("profile_visibility")
}

enum ExternalProfileProvider {
  DUPR

  @@map("external_profile_provider")
}

enum ProfileAvatarState {
  PENDING_UPLOAD
  PENDING_SCAN
  ACTIVE
  REJECTED

  @@map("profile_avatar_state")
}

enum ProfileProjectionGenerationState {
  BUILDING
  READY
  ACTIVE
  SUPERSEDED
  FAILED

  @@map("profile_projection_generation_state")
}

enum PlayerStatisticSlice {
  ALL
  SINGLES
  DOUBLES

  @@map("player_statistic_slice")
}

enum PlayerStatisticOutcome {
  PLAYED_WITHOUT_SCORE
  WON
  LOST
  EXCLUDED

  @@map("player_statistic_outcome")
}

enum PlayerReliabilityContributionKind {
  ORGANIZED_SUCCESS
  ORGANIZED_FAILURE
  CONFIRMED_NO_SHOW

  @@map("player_reliability_contribution_kind")
}

model PlayerProfile {
  userId              String            @id @map("user_id") @db.Uuid
  version             Int               @default(0)
  visibility          ProfileVisibility @default(PUBLIC)
  displayName         String            @map("display_name") @db.VarChar(50)
  localityId          String            @map("locality_id") @db.Uuid
  gameFormats         MatchFormat[]     @default([]) @map("game_formats")
  skillSelfAssessment Decimal           @map("skill_self_assessment") @db.Decimal(2, 1)
  timeZone            String            @map("time_zone") @db.VarChar(64)
  activeAvatarAssetId String?           @map("active_avatar_asset_id") @db.Uuid
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([visibility, updatedAt, userId], map: "player_profiles_public_idx")
  @@map("player_profiles")
}

model ExternalProfileLink {
  id                   String                  @id @db.Uuid
  userId               String                  @map("user_id") @db.Uuid
  provider             ExternalProfileProvider
  urlKey               String                  @map("url_key") @db.Char(64)
  urlCiphertext        Bytes                   @map("url_ciphertext")
  encryptionKeyVersion Int                     @map("encryption_key_version")
  policyVersion        String                  @map("policy_version") @db.VarChar(128)
  outboundEnabled      Boolean                 @default(false) @map("outbound_enabled")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, provider], map: "external_profile_links_user_provider_key")
  @@map("external_profile_links")
}

model ProfileAvatarAsset {
  id                 String             @id @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  objectKey          String             @unique(map: "profile_avatar_assets_object_key") @map("object_key") @db.VarChar(512)
  state              ProfileAvatarState @default(PENDING_UPLOAD)
  mediaType          String             @map("media_type") @db.VarChar(32)
  expectedBytes      Int                @map("expected_bytes")
  expectedSha256     String             @map("expected_sha256") @db.Char(64)
  activatedAt        DateTime?          @map("activated_at") @db.Timestamptz(3)
  rejectedAt         DateTime?          @map("rejected_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadExpiresAt    DateTime           @map("upload_expires_at") @db.Timestamptz(3)
  retentionExpiresAt DateTime?          @map("retention_expires_at") @db.Timestamptz(3)

  @@index([userId, state, createdAt], map: "profile_avatar_assets_user_state_idx")
  @@index([uploadExpiresAt], map: "profile_avatar_assets_upload_expiry_idx")
  @@map("profile_avatar_assets")
}

model ProfileProjectionGeneration {
  id                   String                           @id @db.Uuid
  state                ProfileProjectionGenerationState @default(BUILDING)
  snapshotCutoff       DateTime                         @map("snapshot_cutoff") @db.Timestamptz(3)
  snapshotRevision     BigInt                           @map("snapshot_revision")
  contributionCount    BigInt                           @default(0) @map("contribution_count")
  contributionChecksum String                           @map("contribution_checksum") @db.Char(64)
  checkpointMatchId    String?                          @map("checkpoint_match_id") @db.Uuid
  createdAt            DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  readyAt              DateTime?                        @map("ready_at") @db.Timestamptz(3)
  activatedAt          DateTime?                        @map("activated_at") @db.Timestamptz(3)
  failedAt             DateTime?                        @map("failed_at") @db.Timestamptz(3)
  failureCode          String?                          @map("failure_code") @db.VarChar(96)

  @@index([state, createdAt], map: "profile_projection_generations_state_idx")
  @@map("profile_projection_generations")
}

model PlayerStatisticContribution {
  generationId        String                 @map("generation_id") @db.Uuid
  matchId             String                 @map("match_id") @db.Uuid
  playerId            String                 @map("player_id") @db.Uuid
  eligibilityRevision BigInt                 @map("eligibility_revision")
  markerId            String?                @map("marker_id") @db.Uuid
  format              MatchFormat
  outcome             PlayerStatisticOutcome
  gamesPlayed         Int                    @default(0) @map("games_played")
  pointsFor           Int                    @default(0) @map("points_for")
  pointsAgainst       Int                    @default(0) @map("points_against")
  confirmedAt         DateTime?              @map("confirmed_at") @db.Timestamptz(3)
  sourceChecksum      String                 @map("source_checksum") @db.Char(64)
  appliedAt           DateTime               @default(now()) @map("applied_at") @db.Timestamptz(3)

  @@id([generationId, matchId, playerId])
  @@index([generationId, playerId, format], map: "player_statistic_contributions_aggregate_idx")
  @@index([matchId, eligibilityRevision], map: "player_statistic_contributions_source_idx")
  @@map("player_statistic_contributions")
}

model PlayerStatisticAggregate {
  generationId    String               @map("generation_id") @db.Uuid
  playerId        String               @map("player_id") @db.Uuid
  slice           PlayerStatisticSlice
  played          BigInt               @default(0)
  wins            BigInt               @default(0)
  losses          BigInt               @default(0)
  gamesPlayed     BigInt               @default(0) @map("games_played")
  pointsFor       BigInt               @default(0) @map("points_for")
  pointsAgainst   BigInt               @default(0) @map("points_against")
  lastConfirmedAt DateTime?            @map("last_confirmed_at") @db.Timestamptz(3)
  calculatedAt    DateTime             @default(now()) @map("calculated_at") @db.Timestamptz(3)

  @@id([generationId, playerId, slice])
  @@index([playerId, generationId], map: "player_statistic_aggregates_player_idx")
  @@map("player_statistic_aggregates")
}

model PlayerReliabilityContribution {
  generationId        String                            @map("generation_id") @db.Uuid
  matchId             String                            @map("match_id") @db.Uuid
  playerId            String                            @map("player_id") @db.Uuid
  kind                PlayerReliabilityContributionKind
  eligibilityRevision BigInt                            @map("eligibility_revision")
  sourceDecisionId    String?                           @map("source_decision_id") @db.Uuid
  occurredAt          DateTime                          @map("occurred_at") @db.Timestamptz(3)
  appliedAt           DateTime                          @default(now()) @map("applied_at") @db.Timestamptz(3)

  @@id([generationId, matchId, playerId, kind])
  @@index([generationId, playerId, kind], map: "player_reliability_contributions_aggregate_idx")
  @@map("player_reliability_contributions")
}

model PlayerReliabilityAggregate {
  generationId       String   @map("generation_id") @db.Uuid
  playerId           String   @map("player_id") @db.Uuid
  organizedSuccesses BigInt   @default(0) @map("organized_successes")
  organizedFailures  BigInt   @default(0) @map("organized_failures")
  confirmedNoShows   BigInt   @default(0) @map("confirmed_no_shows")
  calculatedAt       DateTime @default(now()) @map("calculated_at") @db.Timestamptz(3)

  @@id([generationId, playerId])
  @@index([playerId, generationId], map: "player_reliability_aggregates_player_idx")
  @@map("player_reliability_aggregates")
}

model ProfileProjectionEventReceipt {
  consumerKey    String   @map("consumer_key") @db.VarChar(80)
  eventId        String   @map("event_id") @db.Uuid
  sourceType     String   @map("source_type") @db.VarChar(160)
  sourceId       String   @map("source_id") @db.Uuid
  sourceRevision BigInt   @map("source_revision")
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumerKey, eventId])
  @@index([consumerKey, sourceType, sourceId, sourceRevision], map: "profile_projection_receipts_source_idx")
  @@map("profile_projection_event_receipts")
}

model ProfileIdempotencyRecord {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(200)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)

  @@unique([userId, method, canonicalPath, idempotencyKey], map: "profile_idempotency_scope_key")
  @@index([expiresAt], map: "profile_idempotency_expiry_idx")
  @@map("profile_idempotency_records")
}

// Trust and safety data contract. Restricted text is ciphertext; SQL owns lifecycle and append-only guards.
enum SafetyReviewState {
  ACTIVE
  WITHDRAWN
  EXCLUDED

  @@map("safety_review_state")
}

enum SafetyReviewRevisionKind {
  SUBMITTED
  WITHDRAWN
  TEXT_REDACTED

  @@map("safety_review_revision_kind")
}

enum SafetySignalKind {
  NO_SHOW
  SAFETY
  CONTENT
  VENUE
  RESULT

  @@map("safety_signal_kind")
}

enum SafetySignalState {
  RECEIVED
  LINKED
  UNDER_REVIEW
  WITHDRAW_REQUESTED
  RESOLVED

  @@map("safety_signal_state")
}

enum SafetyNoShowReason {
  DID_NOT_ARRIVE
  LEFT_BEFORE_PLAY
  UNREACHABLE_AT_START

  @@map("safety_no_show_reason")
}

enum SafetyReportSourceKind {
  MATCH
  CHAT_MESSAGE
  PROFILE
  VENUE
  MATCH_RESULT

  @@map("safety_report_source_kind")
}

enum ModerationCaseState {
  OPEN
  TRIAGED
  ASSIGNED
  INVESTIGATING
  DECIDED
  CLOSED
  REOPENED

  @@map("moderation_case_state")
}

enum ModerationCasePriority {
  URGENT
  HIGH
  NORMAL

  @@map("moderation_case_priority")
}

enum ModerationDecisionOutcome {
  NO_VIOLATION
  CONTENT_RESTRICTED
  WARNING
  INTERACTION_RESTRICTED
  ACCOUNT_RESTRICTED
  NO_SHOW_CONFIRMED
  RESULT_CORRECTED
  VENUE_ROUTED

  @@map("moderation_decision_outcome")
}

enum ModerationEffectState {
  PENDING
  APPLIED
  RETRACTION_PENDING
  RETRACTED
  FAILED

  @@map("moderation_effect_state")
}

enum ModerationAppealState {
  SUBMITTED
  UNDER_REVIEW
  UPHELD
  CHANGED
  REJECTED

  @@map("moderation_appeal_state")
}

enum SafetyPartyRole {
  REPORTER
  SUBJECT

  @@map("safety_party_role")
}

enum SafetyResponseDisposition {
  AGREE
  DISPUTE
  PROVIDE_CONTEXT

  @@map("safety_response_disposition")
}

model Review {
  id                  String            @id @db.Uuid
  authorId            String            @map("author_id") @db.Uuid
  subjectId           String            @map("subject_id") @db.Uuid
  matchId             String            @map("match_id") @db.Uuid
  state               SafetyReviewState @default(ACTIVE)
  currentRevision     Int               @default(1) @map("current_revision")
  eligibilityRevision BigInt            @map("eligibility_revision")
  policyVersion       String            @map("policy_version") @db.VarChar(128)
  editableUntil       DateTime          @map("editable_until") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamptz(3)
  revisions           ReviewRevision[]

  @@unique([authorId, subjectId, matchId], map: "safety_reviews_author_subject_match_key")
  @@index([subjectId, state, updatedAt], map: "safety_reviews_subject_projection_idx")
  @@map("safety_reviews")
}

model ReviewRevision {
  reviewId             String                   @map("review_id") @db.Uuid
  revision             Int
  kind                 SafetyReviewRevisionKind
  experienceRating     Int?                     @map("experience_rating") @db.SmallInt
  tags                 String[]
  textCiphertext       Bytes?                   @map("text_ciphertext")
  encryptionKeyVersion Int?                     @map("encryption_key_version")
  payloadChecksum      String                   @map("payload_checksum") @db.Char(64)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  review               Review                   @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([reviewId, revision])
  @@map("safety_review_revisions")
}

model SafetySignal {
  id                String                @id @db.Uuid
  reporterId        String?               @map("reporter_id") @db.Uuid
  reporterPseudonym String?               @map("reporter_pseudonym") @db.Uuid
  subjectId         String?               @map("subject_id") @db.Uuid
  subjectPseudonym  String?               @map("subject_pseudonym") @db.Uuid
  kind              SafetySignalKind
  state             SafetySignalState     @default(RECEIVED)
  version           Int                   @default(0)
  policyVersion     String                @map("policy_version") @db.VarChar(128)
  uniquenessKey     String                @map("uniqueness_key") @db.Char(64)
  receiptExpiresAt  DateTime              @map("receipt_expires_at") @db.Timestamptz(3)
  resolvedAt        DateTime?             @map("resolved_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @default(now()) @map("updated_at") @db.Timestamptz(3)
  noShowReport      NoShowReport?
  report            Report?
  evidence          SafetyEvidence?
  caseLink          ModerationCaseSignal?
  responses         SafetyCaseResponse[]

  @@unique([reporterId, uniquenessKey], map: "safety_signals_reporter_subject_key")
  @@index([reporterId, createdAt(sort: Desc), id(sort: Desc)], map: "safety_signals_receipt_idx")
  @@index([state, createdAt], map: "safety_signals_state_idx")
  @@index([receiptExpiresAt], map: "safety_signals_retention_idx")
  @@map("safety_signals")
}

model NoShowReport {
  signalId        String             @id @map("signal_id") @db.Uuid
  matchId         String             @map("match_id") @db.Uuid
  subjectPlayerId String             @map("subject_player_id") @db.Uuid
  reason          SafetyNoShowReason
  sourceRevision  BigInt             @map("source_revision")
  eligibilityEnds DateTime           @map("eligibility_ends") @db.Timestamptz(3)
  signal          SafetySignal       @relation(fields: [signalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([matchId, subjectPlayerId], map: "no_show_reports_subject_match_idx")
  @@map("no_show_reports")
}

model Report {
  signalId       String                 @id @map("signal_id") @db.Uuid
  sourceKind     SafetyReportSourceKind @map("source_kind")
  sourceId       String                 @map("source_id") @db.Uuid
  sourceRevision BigInt                 @map("source_revision")
  reasonCode     String                 @map("reason_code") @db.VarChar(64)
  timeBucket     String?                @map("time_bucket") @db.VarChar(32)
  signal         SafetySignal           @relation(fields: [signalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sourceKind, sourceId, sourceRevision], map: "safety_reports_source_idx")
  @@map("safety_reports")
}

model SafetyEvidence {
  signalId             String       @id @map("signal_id") @db.Uuid
  ciphertext           Bytes
  encryptionKeyVersion Int          @map("encryption_key_version")
  aadVersion           Int          @map("aad_version")
  contentChecksum      String       @map("content_checksum") @db.Char(64)
  retentionExpiresAt   DateTime     @map("retention_expires_at") @db.Timestamptz(3)
  cryptoshreddedAt     DateTime?    @map("cryptoshredded_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  signal               SafetySignal @relation(fields: [signalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([retentionExpiresAt], map: "safety_evidence_retention_idx")
  @@map("safety_evidence")
}

model ModerationCase {
  id                  String                 @id @db.Uuid
  category            SafetySignalKind
  state               ModerationCaseState    @default(OPEN)
  priority            ModerationCasePriority @default(NORMAL)
  revision            Int                    @default(0)
  assignedModeratorId String?                @map("assigned_moderator_id") @db.Uuid
  conflictDetectedAt  DateTime?              @map("conflict_detected_at") @db.Timestamptz(3)
  retentionExpiresAt  DateTime               @map("retention_expires_at") @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @default(now()) @map("updated_at") @db.Timestamptz(3)
  closedAt            DateTime?              @map("closed_at") @db.Timestamptz(3)
  signals             ModerationCaseSignal[]
  decisions           ModerationDecision[]
  responses           SafetyCaseResponse[]
  legalHolds          SafetyLegalHold[]

  @@index([state, priority, createdAt], map: "moderation_cases_queue_idx")
  @@index([assignedModeratorId, state], map: "moderation_cases_assignment_idx")
  @@index([retentionExpiresAt], map: "moderation_cases_retention_idx")
  @@map("moderation_cases")
}

model ModerationCaseSignal {
  caseId   String         @map("case_id") @db.Uuid
  signalId String         @unique(map: "moderation_case_signals_signal_key") @map("signal_id") @db.Uuid
  linkedAt DateTime       @default(now()) @map("linked_at") @db.Timestamptz(3)
  case     ModerationCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  signal   SafetySignal   @relation(fields: [signalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([caseId, signalId])
  @@map("moderation_case_signals")
}

model SafetyCaseResponse {
  id                   String                     @id @db.Uuid
  caseId               String                     @map("case_id") @db.Uuid
  signalId             String                     @map("signal_id") @db.Uuid
  authorId             String                     @map("author_id") @db.Uuid
  partyRole            SafetyPartyRole            @map("party_role")
  disposition          SafetyResponseDisposition?
  ciphertext           Bytes
  encryptionKeyVersion Int                        @map("encryption_key_version")
  aadVersion           Int                        @map("aad_version")
  retentionExpiresAt   DateTime                   @map("retention_expires_at") @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  case                 ModerationCase             @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  signal               SafetySignal               @relation(fields: [signalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([caseId, createdAt], map: "safety_case_responses_case_idx")
  @@index([retentionExpiresAt], map: "safety_case_responses_retention_idx")
  @@map("safety_case_responses")
}

model ModerationDecision {
  id                   String                    @id @db.Uuid
  caseId               String                    @map("case_id") @db.Uuid
  revision             Int
  supersedesDecisionId String?                   @map("supersedes_decision_id") @db.Uuid
  reviewerId           String                    @map("reviewer_id") @db.Uuid
  outcome              ModerationDecisionOutcome
  policyCode           String                    @map("policy_code") @db.VarChar(96)
  policyVersion        String                    @map("policy_version") @db.VarChar(128)
  scopeCode            String                    @map("scope_code") @db.VarChar(96)
  basisChecksum        String                    @map("basis_checksum") @db.Char(64)
  expiresAt            DateTime?                 @map("expires_at") @db.Timestamptz(3)
  reviewDeadline       DateTime?                 @map("review_deadline") @db.Timestamptz(3)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  case                 ModerationCase            @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  effects              ModerationEffect[]
  appeals              ModerationAppeal[]

  @@unique([caseId, revision], map: "moderation_decisions_case_revision_key")
  @@index([expiresAt], map: "moderation_decisions_expiry_idx")
  @@map("moderation_decisions")
}

model ModerationEffect {
  id               String                    @id @db.Uuid
  decisionId       String                    @map("decision_id") @db.Uuid
  kind             ModerationDecisionOutcome
  state            ModerationEffectState     @default(PENDING)
  logicalKey       String                    @unique(map: "moderation_effects_logical_key") @map("logical_key") @db.Char(64)
  ownerReferenceId String                    @map("owner_reference_id") @db.Uuid
  noShowMatchId    String?                   @map("no_show_match_id") @db.Uuid
