  @@index([entrantId, state], map: "entrant_members_entry_idx")
  @@index([tournamentId, userId, state], map: "entrant_members_user_idx")
  @@map("tournament_entrant_members")
}

model TournamentPartnerIntent {
  id            String                       @id @db.Uuid
  tournamentId  String                       @map("tournament_id") @db.Uuid
  userId        String                       @map("user_id") @db.Uuid
  revision      Int                          @default(0)
  state         TournamentPartnerIntentState @default(PENDING)
  matchingOptIn Boolean                      @default(true) @map("matching_opt_in")
  fifoSequence  BigInt                       @map("fifo_sequence")
  registeredAt  DateTime                     @default(now()) @map("registered_at") @db.Timestamptz(3)
  terminalAt    DateTime?                    @map("terminal_at") @db.Timestamptz(3)
  tournament    Tournament                   @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tournamentId, fifoSequence], map: "tournament_partner_intents_fifo_key")
  @@index([tournamentId, state, fifoSequence], map: "tournament_partner_intents_queue_idx")
  @@map("tournament_partner_intents")
}

model TournamentRole {
  id           String               @id @db.Uuid
  tournamentId String               @map("tournament_id") @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  role         TournamentScopedRole
  active       Boolean              @default(true)
  revision     Int                  @default(0)
  assignedAt   DateTime             @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt      DateTime?            @map("ended_at") @db.Timestamptz(3)
  tournament   Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tournamentId, active, role, userId], map: "tournament_roles_access_idx")
  @@map("tournament_roles")
}

model Stage {
  id           String              @id @db.Uuid
  tournamentId String              @map("tournament_id") @db.Uuid
  sequence     Int                 @db.SmallInt
  kind         TournamentStageKind
  strategyKey  String              @map("strategy_key") @db.VarChar(80)
  tournament   Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rounds       Round[]

  @@unique([tournamentId, sequence], map: "tournament_stages_sequence_key")
  @@unique([tournamentId, strategyKey], map: "tournament_stages_strategy_key")
  @@map("tournament_stages")
}

model Round {
  id          String               @id @db.Uuid
  stageId     String               @map("stage_id") @db.Uuid
  sequence    Int                  @db.SmallInt
  generation  Int                  @default(1)
  revision    Int                  @default(0)
  state       TournamentRoundState @default(PLANNED)
  startedAt   DateTime?            @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?            @map("completed_at") @db.Timestamptz(3)
  stage       Stage                @relation(fields: [stageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  matches     TournamentMatch[]

  @@unique([stageId, sequence, generation], map: "tournament_rounds_generation_key")
  @@index([stageId, state, sequence], map: "tournament_rounds_stage_idx")
  @@map("tournament_rounds")
}

model TournamentMatch {
  id                    String                  @id @db.Uuid
  tournamentId          String                  @map("tournament_id") @db.Uuid
  stageId               String                  @map("stage_id") @db.Uuid
  roundId               String                  @map("round_id") @db.Uuid
  strategyKey           String                  @map("strategy_key") @db.VarChar(120)
  sequence              Int                     @db.SmallInt
  revision              Int                     @default(0)
  resultRevision        Int                     @default(0) @map("result_revision")
  state                 TournamentMatchState    @default(PLANNED)
  winnerEntrantId       String?                 @map("winner_entrant_id") @db.Uuid
  authoritativeResultId String?                 @map("authoritative_result_id") @db.Uuid
  startedAt             DateTime?               @map("started_at") @db.Timestamptz(3)
  terminalAt            DateTime?               @map("terminal_at") @db.Timestamptz(3)
  tournament            Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  round                 Round                   @relation(fields: [roundId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  slots                 TournamentMatchSlot[]
  courtAssignments      CourtAssignment[]
  results               TournamentMatchResult[]

  @@unique([tournamentId, strategyKey], map: "tournament_matches_strategy_key")
  @@unique([roundId, sequence], map: "tournament_matches_round_sequence_key")
  @@index([tournamentId, state, roundId], map: "tournament_matches_execution_idx")
  @@map("tournament_matches")
}

model TournamentMatchSlot {
  tournamentMatchId String                       @map("tournament_match_id") @db.Uuid
  position          Int                          @db.SmallInt
  entrantId         String?                      @map("entrant_id") @db.Uuid
  sourceMatchId     String?                      @map("source_match_id") @db.Uuid
  sourceOutcome     TournamentSlotSourceOutcome? @map("source_outcome")
  match             TournamentMatch              @relation(fields: [tournamentMatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tournamentMatchId, position])
  @@index([sourceMatchId, sourceOutcome], map: "tournament_match_slots_source_idx")
  @@index([entrantId, tournamentMatchId], map: "tournament_match_slots_entrant_idx")
  @@map("tournament_match_slots")
}

model CourtAssignment {
  id                String          @id @db.Uuid
  tournamentMatchId String          @map("tournament_match_id") @db.Uuid
  revision          Int             @default(0)
  courtRank         Int             @map("court_rank") @db.SmallInt
  batch             Int             @db.SmallInt
  startsAt          DateTime?       @map("starts_at") @db.Timestamptz(3)
  assignedAt        DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(3)
  releasedAt        DateTime?       @map("released_at") @db.Timestamptz(3)
  match             TournamentMatch @relation(fields: [tournamentMatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([courtRank, startsAt], map: "court_assignments_schedule_idx")
  @@map("tournament_court_assignments")
}

model TournamentMatchResult {
