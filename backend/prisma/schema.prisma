  STANDARD
  CALM

  @@map("game_mode")
}

enum GameSessionState {
  ISSUED
  COMPLETED
  REJECTED
  EXPIRED

  @@map("game_session_state")
}

enum GameResultOutcome {
  ACCEPTED
  REJECTED

  @@map("game_result_outcome")
}

enum GameRewardKind {
  PRACTICE_MARK
  COSMETIC
  GLOBAL_XP

  @@map("game_reward_kind")
}

enum GameRewardState {
  PENDING
  GRANTED
  CAPPED
  REJECTED
  REVERSED
  REINSTATED

  @@map("game_reward_state")
}

enum GameCosmeticState {
  UNLOCKED
  REVOKED
