  enabled            Boolean           @default(true)
  baseXp             Int               @map("base_xp")
  coefficientTenths  Int               @map("coefficient_tenths") @db.SmallInt
  dailyEventCap      Int               @map("daily_event_cap") @db.SmallInt
  weeklyEventCap     Int               @map("weekly_event_cap") @db.SmallInt
  effectiveFrom      DateTime          @map("effective_from") @db.Timestamptz(3)
  effectiveUntil     DateTime?         @map("effective_until") @db.Timestamptz(3)
  snapshotHash       String            @map("snapshot_hash") @db.Char(64)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([scopeKind, clubId, effectiveFrom], map: "xp_rule_definitions_effective_idx")
  @@map("xp_rule_definitions")
}

model XpLedgerEntry {
  id                    String              @id @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  scopeKind             GamificationScopeKind @map("scope_kind")
  clubId                String?             @map("club_id") @db.Uuid
  sourceKind            XpSourceKind        @map("source_kind")
  sourceEventId         String              @map("source_event_id") @db.Uuid
  sourceOccurredAt      DateTime            @map("source_occurred_at") @db.Timestamptz(3)
  ruleDefinitionId      String              @map("rule_definition_id") @db.Uuid
  ruleVersion           String              @map("rule_version") @db.VarChar(32)
  kind                  XpLedgerEntryKind
  status                XpLedgerEntryStatus
  amount                Int
  compensationOfEntryId String?             @map("compensation_of_entry_id") @db.Uuid
  reasonCode            String?             @map("reason_code") @db.VarChar(96)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, scopeKind, clubId, createdAt, id], map: "xp_ledger_entries_owner_idx")
  @@index([compensationOfEntryId], map: "xp_ledger_entries_compensation_idx")
  @@map("xp_ledger_entries")
}

model XpBalance {
