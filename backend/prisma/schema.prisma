  @@index([matchId, state, createdAt, id], map: "join_requests_pending_idx")
  @@map("join_requests")
}

model WaitlistEntry {
  id             String             @id @db.Uuid
  matchId        String             @map("match_id") @db.Uuid
  playerId       String             @map("player_id") @db.Uuid
  teamChoice     MatchTeamChoice    @map("team_choice")
