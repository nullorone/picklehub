  cap7Days          Int                  @map("cap_7_days") @db.SmallInt
  placementIds      String[]             @map("placement_ids") @db.Uuid
  creativeIds       String[]             @map("creative_ids") @db.Uuid
  legalLabel        String               @map("legal_label") @db.VarChar(40)
  legalDisclosure   String?              @map("legal_disclosure") @db.VarChar(500)
  registrationToken String?              @map("registration_token") @db.VarChar(160)
