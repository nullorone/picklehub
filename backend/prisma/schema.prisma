  toilet               VenueAmenityState                     @default(UNKNOWN)
  drinkingWater        VenueAmenityState                     @default(UNKNOWN) @map("drinking_water")
  parking              VenueAmenityState                     @default(UNKNOWN)
  wheelchairAccess     VenueAmenityState                     @default(UNKNOWN) @map("wheelchair_access")
  openingHours         Json?                                 @map("opening_hours")
  seasonality          String?                               @db.VarChar(500)
  closedUntil          DateTime?                             @map("closed_until") @db.Timestamptz(3)
  version              Int                                   @default(1)
  lastVerifiedAt       DateTime                              @map("last_verified_at") @db.Timestamptz(3)
  createdAt            DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                              @default(now()) @map("updated_at") @db.Timestamptz(3)
  canonicalVenueId     String?                               @map("canonical_venue_id") @db.Uuid
  canonicalVenue       Venue?                                @relation("VenueCanonical", fields: [canonicalVenueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mergedAliases        Venue[]                               @relation("VenueCanonical")
  sources              VenueSource[]
  candidates           VenueCandidate[]
  revisions            VenueRevision[]
  reports              VenueReport[]
  decisions            VenueModerationDecision[]
