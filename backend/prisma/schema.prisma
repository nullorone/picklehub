  startsAt               DateTime               @map("starts_at") @db.Timestamptz(3)
  endsAt                 DateTime               @map("ends_at") @db.Timestamptz(3)
  ruleVersion            String                 @map("rule_version") @db.VarChar(32)
  definitionSnapshot     Json                   @map("definition_snapshot")
  definitionSnapshotHash String                 @map("definition_snapshot_hash") @db.Char(64)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([scopeKind, clubId, startsAt, endsAt], map: "leaderboard_seasons_scope_window_idx")
