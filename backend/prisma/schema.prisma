}

model LeaderboardConsent {
  id            String   @id @db.Uuid
  seasonId      String   @map("season_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  revision      Int
  optedIn       Boolean  @map("opted_in")
  policyVersion String   @map("policy_version") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([seasonId, userId, revision], map: "leaderboard_consents_revision_key")
  @@index([seasonId, userId, createdAt], map: "leaderboard_consents_current_idx")
  @@map("leaderboard_consents")
}

model LeaderboardEntry {
  seasonId          String   @map("season_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  consentRevision   Int      @map("consent_revision")
  rank              Int
  seasonalNetXp     BigInt   @map("seasonal_net_xp")
  levelDefinitionId String   @map("level_definition_id") @db.Uuid
  projectionRevision BigInt  @map("projection_revision")
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([seasonId, userId])
  @@index([seasonId, rank, userId], map: "leaderboard_entries_page_idx")
  @@index([seasonId, seasonalNetXp], map: "leaderboard_entries_xp_idx")
  @@map("leaderboard_entries")
}

model ProcessedGamificationEvent {
  messageId       String   @id @map("message_id") @db.Uuid
  eventType       String   @map("event_type") @db.VarChar(160)
  sourceEventId   String   @map("source_event_id") @db.Uuid
  sourceRevision  Int      @map("source_revision")
  payloadHash     String   @map("payload_hash") @db.Char(64)
  outcome         String   @db.VarChar(32)
  processedAt     DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@unique([eventType, sourceEventId, sourceRevision], map: "processed_gamification_events_source_key")
  @@index([processedAt], map: "processed_gamification_events_retention_idx")
  @@map("processed_gamification_events")
}

model GamificationOperationReceipt {
  id                   String   @id @db.Uuid
  actorUserId          String   @map("actor_user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(200)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)

  @@unique([actorUserId, method, canonicalPath, idempotencyKey], map: "gamification_operation_receipts_scope_key")
  @@index([expiresAt], map: "gamification_operation_receipts_expiry_idx")
  @@map("gamification_operation_receipts")
}
