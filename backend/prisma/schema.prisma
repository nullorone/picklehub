generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  OPEN
  CANCELLED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  DEAD
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  displayName      String            @default("Игрок") @map("display_name") @db.VarChar(120)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  telegramIdentity TelegramIdentity?
  sessions         Session[]
  organizedGames   Game[]            @relation("GameOrganizer")
  participations   GameParticipant[]
  idempotencyKeys IdempotencyRecord[]

  @@map("users")
}

model TelegramIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  telegramUserId BigInt   @unique @map("telegram_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  privateChatId  BigInt?  @unique @map("private_chat_id")
  canMessage     Boolean  @default(false) @map("can_message")
  botStartedAt   DateTime? @map("bot_started_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_identities")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model Game {
  id               String            @id @default(uuid()) @db.Uuid
  organizerId      String            @map("organizer_id") @db.Uuid
  venueName        String            @map("venue_name") @db.VarChar(160)
  address          String            @db.VarChar(300)
  startsAt         DateTime          @map("starts_at") @db.Timestamptz(3)
  durationMinutes  Int               @map("duration_minutes") @db.SmallInt
  participantLimit Int               @map("participant_limit") @db.SmallInt
  level            String?           @db.VarChar(80)
  description      String?           @db.VarChar(2000)
  status           GameStatus        @default(OPEN)
  eventVersion     Int               @default(1) @map("event_version")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizer        User              @relation("GameOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  participants     GameParticipant[]
  jobs             Job[]

  @@index([startsAt, status])
  @@map("games")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.VarChar(128)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  response       Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("idempotency_records")
}

model GameParticipant {
  id       String   @id @default(uuid()) @db.Uuid
  gameId   String   @map("game_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
  @@map("game_participants")
}

model Job {
  id               String    @id @default(uuid()) @db.Uuid
  gameId           String?   @map("game_id") @db.Uuid
  type             String    @db.VarChar(40)
  eventVersion     Int       @map("event_version")
  deduplicationKey String    @unique @map("deduplication_key") @db.VarChar(200)
  payload          Json      @default("{}") @db.JsonB
  status           JobStatus @default(PENDING)
  attempts         Int       @default(0)
  maxAttempts      Int       @default(8) @map("max_attempts")
  availableAt      DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy         String?   @map("locked_by") @db.VarChar(100)
  lastErrorCode    String?   @map("last_error_code") @db.VarChar(80)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  game             Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@index([gameId, eventVersion])
  @@map("jobs")
}
