  markedAt       DateTime               @default(now()) @map("marked_at") @db.Timestamptz(3)
  entrant        Entrant                @relation(fields: [entrantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([entrantId, revision], map: "tournament_payment_marks_revision_key")
  @@index([tournamentId, entrantId, markedAt], map: "tournament_payment_marks_entry_idx")
  @@map("tournament_payment_marks")
}

model TournamentOperationReceipt {
  id                   String   @id @db.Uuid
  tournamentId         String?  @map("tournament_id") @db.Uuid
  actorUserId          String   @map("actor_user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(200)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
