model ModerationEffect {
  id               String                    @id @db.Uuid
  decisionId       String                    @map("decision_id") @db.Uuid
  kind             ModerationDecisionOutcome
  state            ModerationEffectState     @default(PENDING)
  logicalKey       String                    @unique(map: "moderation_effects_logical_key") @map("logical_key") @db.Char(64)
  ownerReferenceId String                    @map("owner_reference_id") @db.Uuid
  noShowMatchId    String?                   @map("no_show_match_id") @db.Uuid
  noShowSubjectId  String?                   @map("no_show_subject_id") @db.Uuid
  sourceRevision   BigInt                    @map("source_revision")
  appliedAt        DateTime?                 @map("applied_at") @db.Timestamptz(3)
  retractedAt      DateTime?                 @map("retracted_at") @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  decision         ModerationDecision        @relation(fields: [decisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([state, createdAt], map: "moderation_effects_dispatch_idx")
  @@map("moderation_effects")
}

model ModerationAppeal {
  id                   String                @id @db.Uuid
  decisionId           String                @map("decision_id") @db.Uuid
  appellantId          String                @map("appellant_id") @db.Uuid
  reviewerId           String?               @map("reviewer_id") @db.Uuid
  state                ModerationAppealState @default(SUBMITTED)
  reasonCode           String                @map("reason_code") @db.VarChar(64)
  textCiphertext       Bytes?                @map("text_ciphertext")
  encryptionKeyVersion Int?                  @map("encryption_key_version")
  retentionExpiresAt   DateTime              @map("retention_expires_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @default(now()) @map("updated_at") @db.Timestamptz(3)
  decision             ModerationDecision    @relation(fields: [decisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([decisionId, appellantId], map: "moderation_appeals_decision_appellant_key")
  @@index([state, createdAt], map: "moderation_appeals_queue_idx")
  @@index([retentionExpiresAt], map: "moderation_appeals_retention_idx")
  @@map("moderation_appeals")
}

model ReviewReputationContribution {
  reviewId       String   @id @map("review_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  matchId        String   @map("match_id") @db.Uuid
  authorKey      String   @map("author_key") @db.Char(64)
  reviewRevision Int      @map("review_revision")
  rating         Int      @db.SmallInt
  eligible       Boolean
  sourceChecksum String   @map("source_checksum") @db.Char(64)
  appliedAt      DateTime @default(now()) @map("applied_at") @db.Timestamptz(3)

  @@unique([subjectId, matchId, authorKey], map: "review_reputation_distinct_source_key")
  @@index([subjectId, eligible], map: "review_reputation_contributions_subject_idx")
  @@map("review_reputation_contributions")
}

model ReviewReputationAggregate {
  subjectId    String   @id @map("subject_id") @db.Uuid
  ratingSum    BigInt   @default(0) @map("rating_sum")
  reviewCount  BigInt   @default(0) @map("review_count")
  sourceDigest String   @map("source_digest") @db.Char(64)
  calculatedAt DateTime @default(now()) @map("calculated_at") @db.Timestamptz(3)

  @@map("review_reputation_aggregates")
}

model SafetyLegalHold {
  id          String         @id @db.Uuid
  caseId      String         @map("case_id") @db.Uuid
  recordScope String         @map("record_scope") @db.VarChar(96)
  reasonCode  String         @map("reason_code") @db.VarChar(96)
  ownerId     String         @map("owner_id") @db.Uuid
  reviewAt    DateTime       @map("review_at") @db.Timestamptz(3)
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)
  releasedAt  DateTime?      @map("released_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  case        ModerationCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt, releasedAt], map: "safety_legal_holds_expiry_idx")
  @@map("safety_legal_holds")
}

model SafetyIdempotencyRecord {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(200)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)

  @@unique([userId, method, canonicalPath, idempotencyKey], map: "safety_idempotency_scope_key")
  @@index([expiresAt], map: "safety_idempotency_expiry_idx")
  @@map("safety_idempotency_records")
}

// Communications data contract. SQL owns partial uniqueness, append-only revisions and monotonic sequence guards.
enum ConversationState {
  WRITABLE
  READ_ONLY

  @@map("conversation_state")
}

enum ChatMessageKind {
  USER
  SYSTEM

  @@map("chat_message_kind")
}

enum ChatRevisionKind {
  CREATED
  EDITED
  DELETED

  @@map("chat_revision_kind")
}

enum ChatReportReason {
  SPAM
  HARASSMENT
  HATE
  THREAT
  OTHER

  @@map("chat_report_reason")
}

enum NotificationCategory {
  ROSTER
  REQUESTS
  MATCH_CRITICAL
  REMINDERS
  RESULTS
  CHAT

  @@map("notification_category")
}

enum NotificationChannel {
  IN_APP
  TELEGRAM
  EMAIL
  PUSH

  @@map("notification_channel")
}

enum NotificationDeliveryStatus {
  PENDING
  DEFERRED
  PROCESSING
  ACCEPTED
  DELIVERED
  FAILED
  SUPPRESSED
  QUARANTINED

  @@map("notification_delivery_status")
}

enum CommunicationPlatform {
  WEB
  TMA
  MOBILE

  @@map("communication_platform")
}

model Conversation {
  id                 String                   @id @db.Uuid
  matchId            String                   @unique(map: "conversations_match_key") @map("match_id") @db.Uuid
  state              ConversationState        @default(WRITABLE)
  version            Int                      @default(0)
  latestSequence     BigInt                   @default(0) @map("latest_sequence")
  writeClosesAt      DateTime?                @map("write_closes_at") @db.Timestamptz(3)
  retentionExpiresAt DateTime?                @map("retention_expires_at") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(3)
  match              Match                    @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships        ConversationMembership[]
  messages           ChatMessage[]

  @@map("conversations")
}

model ConversationMembership {
  id                    String       @id @db.Uuid
  conversationId        String       @map("conversation_id") @db.Uuid
  userId                String       @map("user_id") @db.Uuid
  accessGrantedAt       DateTime     @default(now()) @map("access_granted_at") @db.Timestamptz(3)
  accessRevokedAt       DateTime?    @map("access_revoked_at") @db.Timestamptz(3)
  accessThroughSequence BigInt?      @map("access_through_sequence")
  readAccessExpiresAt   DateTime?    @map("read_access_expires_at") @db.Timestamptz(3)
  lastReadSequence      BigInt       @default(0) @map("last_read_sequence")
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, readAccessExpiresAt, conversationId], map: "conversation_memberships_user_access_idx")
  @@map("conversation_memberships")
}

model ChatMessage {
  id              String                @id @db.Uuid
  conversationId  String                @map("conversation_id") @db.Uuid
  sequence        BigInt
  kind            ChatMessageKind
  authorId        String?               @map("author_id") @db.Uuid
  systemType      String?               @map("system_type") @db.VarChar(64)
  sourceEventId   String?               @map("source_event_id") @db.Uuid
  currentRevision Int                   @default(1) @map("current_revision")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt        DateTime?             @map("edited_at") @db.Timestamptz(3)
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(3)
  conversation    Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  author          User?                 @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions       ChatMessageRevision[]

  @@unique([conversationId, sequence], map: "chat_messages_conversation_sequence_key")
  @@index([conversationId, sequence(sort: Desc)], map: "chat_messages_history_idx")
  @@map("chat_messages")
}

model ChatMessageRevision {
  messageId String              @map("message_id") @db.Uuid
  revision  Int
  kind      ChatRevisionKind
  text      String?
  createdBy String?             @map("created_by") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  message   ChatMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  creator   User?               @relation("ChatRevisionCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reports   ChatMessageReport[]

  @@id([messageId, revision])
  @@map("chat_message_revisions")
}

model ChatMessageReport {
  id                   String              @id @db.Uuid
  messageId            String              @map("message_id") @db.Uuid
  messageRevision      Int                 @map("message_revision")
  reporterId           String              @map("reporter_id") @db.Uuid
  reason               ChatReportReason
  operationId          String              @map("operation_id") @db.Uuid
  evidenceCiphertext   Bytes               @map("evidence_ciphertext")
  encryptionKeyVersion Int                 @map("encryption_key_version")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt           DateTime?           @map("resolved_at") @db.Timestamptz(3)
  retentionExpiresAt   DateTime?           @map("retention_expires_at") @db.Timestamptz(3)
  revision             ChatMessageRevision @relation(fields: [messageId, messageRevision], references: [messageId, revision], onDelete: Restrict, onUpdate: Restrict)
  reporter             User                @relation("ChatReportReporter", fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([reporterId, operationId], map: "chat_message_reports_operation_key")
  @@unique([reporterId, messageId, messageRevision], map: "chat_message_reports_target_key")
  @@map("chat_message_reports")
}

model CommunicationBlock {
  blockerId     String   @map("blocker_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  blocker       User     @relation("CommunicationBlocker", fields: [blockerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  blockedUser   User     @relation("CommunicationBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([blockerId, blockedUserId])
  @@map("communication_blocks")
}

model NotificationPreference {
  userId            String                          @id @map("user_id") @db.Uuid
  version           Int                             @default(0)
  locale            String                          @default("ru") @db.VarChar(35)
  timeZone          String                          @default("Europe/Moscow") @map("time_zone") @db.VarChar(64)
  tzdataVersion     String                          @map("tzdata_version") @db.VarChar(32)
  quietHoursEnabled Boolean                         @default(true) @map("quiet_hours_enabled")
  quietHoursStart   DateTime                        @default(dbgenerated("TIME '22:00'")) @map("quiet_hours_start") @db.Time
  quietHoursEnd     DateTime                        @default(dbgenerated("TIME '08:00'")) @map("quiet_hours_end") @db.Time
  updatedAt         DateTime                        @default(now()) @map("updated_at") @db.Timestamptz(3)
  user              User                            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  channels          NotificationPreferenceChannel[]

  @@map("notification_preferences")
}

model NotificationPreferenceChannel {
  userId     String                 @map("user_id") @db.Uuid
  category   NotificationCategory
  channel    NotificationChannel
  enabled    Boolean                @default(false)
  updatedAt  DateTime               @default(now()) @map("updated_at") @db.Timestamptz(3)
  preference NotificationPreference @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([userId, category, channel])
  @@map("notification_preference_channels")
}

model Notification {
  id            String                 @id @db.Uuid
  recipientId   String                 @map("recipient_id") @db.Uuid
  sourceEventId String                 @map("source_event_id") @db.Uuid
  type          String                 @db.VarChar(64)
  category      NotificationCategory
  route         String                 @db.VarChar(64)
  groupKey      String?                @map("group_key") @db.VarChar(128)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt        DateTime?              @map("read_at") @db.Timestamptz(3)
  expiresAt     DateTime               @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '90 days'")) @map("expires_at") @db.Timestamptz(3)
  recipient     User                   @relation(fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveries    NotificationDelivery[]

  @@unique([recipientId, sourceEventId, type], map: "notifications_logical_key")
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_inbox_idx")
  @@index([expiresAt], map: "notifications_expiry_idx")
  @@map("notifications")
}

model NotificationDelivery {
  id                 String                     @id @db.Uuid
  notificationId     String                     @map("notification_id") @db.Uuid
  channel            NotificationChannel
  status             NotificationDeliveryStatus @default(PENDING)
  idempotencyKey     String                     @unique(map: "notification_deliveries_idempotency_key") @map("idempotency_key") @db.Uuid
  notBefore          DateTime                   @default(now()) @map("not_before") @db.Timestamptz(3)
  attempts           Int                        @default(0)
  providerCode       String?                    @map("provider_code") @db.VarChar(32)
  providerMessageKey String?                    @map("provider_message_key") @db.Char(64)
  lastErrorCode      String?                    @map("last_error_code") @db.VarChar(96)
  claimedAt          DateTime?                  @map("claimed_at") @db.Timestamptz(3)
  acceptedAt         DateTime?                  @map("accepted_at") @db.Timestamptz(3)
  deliveredAt        DateTime?                  @map("delivered_at") @db.Timestamptz(3)
  terminalAt         DateTime?                  @map("terminal_at") @db.Timestamptz(3)
  expiresAt          DateTime                   @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '30 days'")) @map("expires_at") @db.Timestamptz(3)
  notification       Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  pushAttempts       PushDeliveryAttempt[]

  @@unique([notificationId, channel], map: "notification_deliveries_logical_key")
  @@index([expiresAt], map: "notification_deliveries_expiry_idx")
  @@map("notification_deliveries")
}

model NotificationDevice {
  installationId    String                @id @map("installation_id") @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  platform          CommunicationPlatform
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime              @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(3)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  pushRegistrations PushRegistration[]

  @@index([userId, revokedAt], map: "notification_devices_user_idx")
  @@map("notification_devices")
}

enum MobileOperatingSystem {
  IOS
  ANDROID

  @@map("mobile_operating_system")
}

enum PushEnvironment {
  SANDBOX
  PRODUCTION

  @@map("push_environment")
}

model PushRegistration {
  id                   String                @id @db.Uuid
  installationId       String                @map("installation_id") @db.Uuid
  operatingSystem      MobileOperatingSystem @map("operating_system")
  environment          PushEnvironment
  appVersion           String                @map("app_version") @db.VarChar(64)
  tokenKey             String?               @map("token_key") @db.Char(64)
  tokenCiphertext      Bytes?                @map("token_ciphertext")
  encryptionKeyVersion Int                   @map("encryption_key_version")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt           DateTime              @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt            DateTime              @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '90 days'")) @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokeReasonCode     String?               @map("revoke_reason_code") @db.VarChar(96)
  device               NotificationDevice    @relation(fields: [installationId], references: [installationId], onDelete: Cascade, onUpdate: Restrict)
  deliveryAttempts     PushDeliveryAttempt[]

  @@index([installationId, revokedAt, expiresAt], map: "push_registrations_installation_active_idx")
  @@index([expiresAt], map: "push_registrations_expiry_idx")
  @@map("push_registrations")
}

model PushDeliveryAttempt {
  id                 String                     @id @db.Uuid
  deliveryId         String                     @map("delivery_id") @db.Uuid
  registrationId     String                     @map("registration_id") @db.Uuid
  status             NotificationDeliveryStatus @default(PENDING)
  attempts           Int                        @default(0)
  providerMessageKey String?                    @map("provider_message_key") @db.Char(64)
  lastErrorCode      String?                    @map("last_error_code") @db.VarChar(96)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  terminalAt         DateTime?                  @map("terminal_at") @db.Timestamptz(3)
  delivery           NotificationDelivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  registration       PushRegistration           @relation(fields: [registrationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([deliveryId, registrationId], map: "push_delivery_attempts_logical_key")
  @@index([status, createdAt, id], map: "push_delivery_attempts_dispatch_idx")
  @@map("push_delivery_attempts")
}

model CommunicationEventReceipt {
  consumerKey String   @map("consumer_key") @db.VarChar(80)
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumerKey, eventId])
  @@map("communication_event_receipts")
}

model CommunicationIdempotencyRecord {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(200)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([userId, method, canonicalPath, idempotencyKey], map: "communication_idempotency_scope_key")
  @@index([expiresAt], map: "communication_idempotency_expiry_idx")
  @@map("communication_idempotency_records")
}

// Clubs data contract. Cross-row ownership, immutable terminal intents and recurring occurrence uniqueness are
// enforced by the additive SQL migration because Prisma cannot express deferred constraint triggers.
enum ClubState {
  ACTIVE
  ARCHIVED

  @@map("club_state")
}

enum ClubMembershipPolicy {
  OPEN
  APPROVAL
  INVITE_ONLY

  @@map("club_membership_policy")
}

enum ClubRole {
  OWNER
  ADMIN
  MEMBER

  @@map("club_role")
}

enum ClubMembershipState {
  ACTIVE
  LEFT
  EXCLUDED
  SUPERSEDED

  @@map("club_membership_state")
}

enum ClubJoinRequestState {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  SUPERSEDED

  @@map("club_join_request_state")
}

enum ClubInvitationState {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
  SUPERSEDED

  @@map("club_invitation_state")
}

enum ClubBlockState {
  ACTIVE
  LIFTED

  @@map("club_block_state")
}

enum RecurringMatchRuleState {
  ACTIVE
  PAUSED
  ENDED

  @@map("recurring_match_rule_state")
}

enum RecurringMatchFrequency {
  WEEKLY

  @@map("recurring_match_frequency")
}

enum RecurringDstGapPolicy {
  SKIP

  @@map("recurring_dst_gap_policy")
}

enum RecurringDstOverlapPolicy {
  EARLIER_OFFSET
  LATER_OFFSET

  @@map("recurring_dst_overlap_policy")
}

enum RecurringOccurrenceState {
  MATERIALIZED
  SKIPPED_DST_GAP
  SKIPPED_PAUSE

  @@map("recurring_occurrence_state")
}

enum ClubMatchOrigin {
  CLUB
  RECURRING_RULE

  @@map("club_match_origin")
}

model Club {
  id                 String               @id @db.Uuid
  version            Int                  @default(0)
  state              ClubState            @default(ACTIVE)
  name               String               @db.VarChar(120)
  normalizedName     String               @map("normalized_name") @db.VarChar(120)
  description        String               @db.VarChar(1000)
  locality           String               @db.VarChar(120)
  normalizedLocality String               @map("normalized_locality") @db.VarChar(120)
  membershipPolicy   ClubMembershipPolicy @map("membership_policy")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?            @map("archived_at") @db.Timestamptz(3)
  memberships        ClubMembership[]
  venues             ClubVenue[]
  matches            Match[]
  recurringRules     RecurringMatchRule[]

  @@index([state, normalizedName, id], map: "clubs_public_search_idx")
  @@index([state, normalizedLocality, normalizedName, id], map: "clubs_locality_search_idx")
  @@map("clubs")
}

model ClubMembership {
  id       String              @id @db.Uuid
  clubId   String              @map("club_id") @db.Uuid
  userId   String              @map("user_id") @db.Uuid
  role     ClubRole
  state    ClubMembershipState @default(ACTIVE)
  revision Int                 @default(0)
  joinedAt DateTime            @default(now()) @map("joined_at") @db.Timestamptz(3)
  endedAt  DateTime?           @map("ended_at") @db.Timestamptz(3)
  club     Club                @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user     User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([clubId, state, role, joinedAt, id], map: "club_memberships_roster_idx")
  @@index([userId, state, clubId], map: "club_memberships_user_idx")
  @@map("club_memberships")
}

model ClubJoinRequest {
  id          String               @id @db.Uuid
  clubId      String               @map("club_id") @db.Uuid
  requesterId String               @map("requester_id") @db.Uuid
  state       ClubJoinRequestState @default(PENDING)
  revision    Int                  @default(0)
