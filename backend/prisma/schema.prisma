  appliedAt           DateTime               @default(now()) @map("applied_at") @db.Timestamptz(3)

  @@id([generationId, matchId, playerId])
  @@index([generationId, playerId, format], map: "player_statistic_contributions_aggregate_idx")
  @@index([matchId, eligibilityRevision], map: "player_statistic_contributions_source_idx")
  @@map("player_statistic_contributions")
}

model PlayerStatisticAggregate {
  generationId    String               @map("generation_id") @db.Uuid
  playerId        String               @map("player_id") @db.Uuid
  slice           PlayerStatisticSlice
  played          BigInt               @default(0)
  wins            BigInt               @default(0)
  losses          BigInt               @default(0)
  gamesPlayed     BigInt               @default(0) @map("games_played")
  pointsFor       BigInt               @default(0) @map("points_for")
  pointsAgainst   BigInt               @default(0) @map("points_against")
  lastConfirmedAt DateTime?            @map("last_confirmed_at") @db.Timestamptz(3)
  calculatedAt    DateTime             @default(now()) @map("calculated_at") @db.Timestamptz(3)

  @@id([generationId, playerId, slice])
  @@index([playerId, generationId], map: "player_statistic_aggregates_player_idx")
  @@map("player_statistic_aggregates")
}

model PlayerReliabilityContribution {
  generationId        String                            @map("generation_id") @db.Uuid
  matchId             String                            @map("match_id") @db.Uuid
  playerId            String                            @map("player_id") @db.Uuid
  kind                PlayerReliabilityContributionKind
  eligibilityRevision BigInt                            @map("eligibility_revision")
  sourceDecisionId    String?                           @map("source_decision_id") @db.Uuid
  occurredAt          DateTime                          @map("occurred_at") @db.Timestamptz(3)
  appliedAt           DateTime                          @default(now()) @map("applied_at") @db.Timestamptz(3)

  @@id([generationId, matchId, playerId, kind])
  @@index([generationId, playerId, kind], map: "player_reliability_contributions_aggregate_idx")
  @@map("player_reliability_contributions")
}

model PlayerReliabilityAggregate {
  generationId       String   @map("generation_id") @db.Uuid
  playerId           String   @map("player_id") @db.Uuid
  organizedSuccesses BigInt   @default(0) @map("organized_successes")
  organizedFailures  BigInt   @default(0) @map("organized_failures")
  confirmedNoShows   BigInt   @default(0) @map("confirmed_no_shows")
  calculatedAt       DateTime @default(now()) @map("calculated_at") @db.Timestamptz(3)

  @@id([generationId, playerId])
  @@index([playerId, generationId], map: "player_reliability_aggregates_player_idx")
  @@map("player_reliability_aggregates")
}

model ProfileProjectionEventReceipt {
  consumerKey    String   @map("consumer_key") @db.VarChar(80)
  eventId        String   @map("event_id") @db.Uuid
  sourceType     String   @map("source_type") @db.VarChar(160)
  sourceId       String   @map("source_id") @db.Uuid
  sourceRevision BigInt   @map("source_revision")
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumerKey, eventId])
  @@index([consumerKey, sourceType, sourceId, sourceRevision], map: "profile_projection_receipts_source_idx")
  @@map("profile_projection_event_receipts")
}

model ProfileIdempotencyRecord {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(200)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)

  @@unique([userId, method, canonicalPath, idempotencyKey], map: "profile_idempotency_scope_key")
  @@index([expiresAt], map: "profile_idempotency_expiry_idx")
  @@map("profile_idempotency_records")
}

// Communications data contract. SQL owns partial uniqueness, append-only revisions and monotonic sequence guards.
enum ConversationState {
  WRITABLE
  READ_ONLY

  @@map("conversation_state")
}

enum ChatMessageKind {
  USER
  SYSTEM

  @@map("chat_message_kind")
}

enum ChatRevisionKind {
  CREATED
  EDITED
  DELETED

  @@map("chat_revision_kind")
}

enum ChatReportReason {
  SPAM
  HARASSMENT
  HATE
  THREAT
  OTHER

  @@map("chat_report_reason")
}

enum NotificationCategory {
  ROSTER
  REQUESTS
  MATCH_CRITICAL
  REMINDERS
  RESULTS
  CHAT

  @@map("notification_category")
}

enum NotificationChannel {
  IN_APP
  TELEGRAM
  EMAIL

  @@map("notification_channel")
}

enum NotificationDeliveryStatus {
  PENDING
  DEFERRED
  PROCESSING
  ACCEPTED
  DELIVERED
  FAILED
  SUPPRESSED
  QUARANTINED

  @@map("notification_delivery_status")
}

enum CommunicationPlatform {
  WEB
  TMA

  @@map("communication_platform")
}

model Conversation {
  id                 String                   @id @db.Uuid
  matchId            String                   @unique(map: "conversations_match_key") @map("match_id") @db.Uuid
  state              ConversationState        @default(WRITABLE)
  version            Int                      @default(0)
  latestSequence     BigInt                   @default(0) @map("latest_sequence")
  writeClosesAt      DateTime?                @map("write_closes_at") @db.Timestamptz(3)
  retentionExpiresAt DateTime?                @map("retention_expires_at") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(3)
  match              Match                    @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships        ConversationMembership[]
  messages           ChatMessage[]

  @@map("conversations")
}

model ConversationMembership {
  id                    String       @id @db.Uuid
  conversationId        String       @map("conversation_id") @db.Uuid
  userId                String       @map("user_id") @db.Uuid
  accessGrantedAt       DateTime     @default(now()) @map("access_granted_at") @db.Timestamptz(3)
  accessRevokedAt       DateTime?    @map("access_revoked_at") @db.Timestamptz(3)
  accessThroughSequence BigInt?      @map("access_through_sequence")
  readAccessExpiresAt   DateTime?    @map("read_access_expires_at") @db.Timestamptz(3)
  lastReadSequence      BigInt       @default(0) @map("last_read_sequence")
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, readAccessExpiresAt, conversationId], map: "conversation_memberships_user_access_idx")
  @@map("conversation_memberships")
}

model ChatMessage {
  id              String                @id @db.Uuid
  conversationId  String                @map("conversation_id") @db.Uuid
  sequence        BigInt
  kind            ChatMessageKind
  authorId        String?               @map("author_id") @db.Uuid
  systemType      String?               @map("system_type") @db.VarChar(64)
  sourceEventId   String?               @map("source_event_id") @db.Uuid
  currentRevision Int                   @default(1) @map("current_revision")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt        DateTime?             @map("edited_at") @db.Timestamptz(3)
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(3)
  conversation    Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  author          User?                 @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions       ChatMessageRevision[]

  @@unique([conversationId, sequence], map: "chat_messages_conversation_sequence_key")
  @@index([conversationId, sequence(sort: Desc)], map: "chat_messages_history_idx")
  @@map("chat_messages")
}

model ChatMessageRevision {
  messageId String              @map("message_id") @db.Uuid
  revision  Int
  kind      ChatRevisionKind
  text      String?
  createdBy String?             @map("created_by") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  message   ChatMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  creator   User?               @relation("ChatRevisionCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reports   ChatMessageReport[]

  @@id([messageId, revision])
  @@map("chat_message_revisions")
}

model ChatMessageReport {
  id                   String              @id @db.Uuid
  messageId            String              @map("message_id") @db.Uuid
  messageRevision      Int                 @map("message_revision")
  reporterId           String              @map("reporter_id") @db.Uuid
  reason               ChatReportReason
  operationId          String              @map("operation_id") @db.Uuid
  evidenceCiphertext   Bytes               @map("evidence_ciphertext")
  encryptionKeyVersion Int                 @map("encryption_key_version")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt           DateTime?           @map("resolved_at") @db.Timestamptz(3)
  retentionExpiresAt   DateTime?           @map("retention_expires_at") @db.Timestamptz(3)
  revision             ChatMessageRevision @relation(fields: [messageId, messageRevision], references: [messageId, revision], onDelete: Restrict, onUpdate: Restrict)
  reporter             User                @relation("ChatReportReporter", fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([reporterId, operationId], map: "chat_message_reports_operation_key")
  @@unique([reporterId, messageId, messageRevision], map: "chat_message_reports_target_key")
  @@map("chat_message_reports")
}

model CommunicationBlock {
  blockerId     String   @map("blocker_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  blocker       User     @relation("CommunicationBlocker", fields: [blockerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  blockedUser   User     @relation("CommunicationBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([blockerId, blockedUserId])
  @@map("communication_blocks")
}

model NotificationPreference {
  userId            String                          @id @map("user_id") @db.Uuid
  version           Int                             @default(0)
  locale            String                          @default("ru") @db.VarChar(35)
  timeZone          String                          @default("Europe/Moscow") @map("time_zone") @db.VarChar(64)
  tzdataVersion     String                          @map("tzdata_version") @db.VarChar(32)
  quietHoursEnabled Boolean                         @default(true) @map("quiet_hours_enabled")
  quietHoursStart   DateTime                        @default(dbgenerated("TIME '22:00'")) @map("quiet_hours_start") @db.Time
  quietHoursEnd     DateTime                        @default(dbgenerated("TIME '08:00'")) @map("quiet_hours_end") @db.Time
  updatedAt         DateTime                        @default(now()) @map("updated_at") @db.Timestamptz(3)
  user              User                            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  channels          NotificationPreferenceChannel[]

  @@map("notification_preferences")
}

model NotificationPreferenceChannel {
  userId     String                 @map("user_id") @db.Uuid
  category   NotificationCategory
  channel    NotificationChannel
  enabled    Boolean                @default(false)
  updatedAt  DateTime               @default(now()) @map("updated_at") @db.Timestamptz(3)
  preference NotificationPreference @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([userId, category, channel])
  @@map("notification_preference_channels")
}

model Notification {
  id            String                 @id @db.Uuid
  recipientId   String                 @map("recipient_id") @db.Uuid
  sourceEventId String                 @map("source_event_id") @db.Uuid
  type          String                 @db.VarChar(64)
  category      NotificationCategory
  route         String                 @db.VarChar(64)
  groupKey      String?                @map("group_key") @db.VarChar(128)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt        DateTime?              @map("read_at") @db.Timestamptz(3)
  expiresAt     DateTime               @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '90 days'")) @map("expires_at") @db.Timestamptz(3)
  recipient     User                   @relation(fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveries    NotificationDelivery[]

  @@unique([recipientId, sourceEventId, type], map: "notifications_logical_key")
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_inbox_idx")
  @@index([expiresAt], map: "notifications_expiry_idx")
  @@map("notifications")
}

model NotificationDelivery {
  id                 String                     @id @db.Uuid
  notificationId     String                     @map("notification_id") @db.Uuid
  channel            NotificationChannel
  status             NotificationDeliveryStatus @default(PENDING)
  idempotencyKey     String                     @unique(map: "notification_deliveries_idempotency_key") @map("idempotency_key") @db.Uuid
  notBefore          DateTime                   @default(now()) @map("not_before") @db.Timestamptz(3)
  attempts           Int                        @default(0)
  providerCode       String?                    @map("provider_code") @db.VarChar(32)
  providerMessageKey String?                    @map("provider_message_key") @db.Char(64)
  lastErrorCode      String?                    @map("last_error_code") @db.VarChar(96)
  claimedAt          DateTime?                  @map("claimed_at") @db.Timestamptz(3)
  acceptedAt         DateTime?                  @map("accepted_at") @db.Timestamptz(3)
  deliveredAt        DateTime?                  @map("delivered_at") @db.Timestamptz(3)
  terminalAt         DateTime?                  @map("terminal_at") @db.Timestamptz(3)
  expiresAt          DateTime                   @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '30 days'")) @map("expires_at") @db.Timestamptz(3)
  notification       Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([notificationId, channel], map: "notification_deliveries_logical_key")
  @@index([expiresAt], map: "notification_deliveries_expiry_idx")
  @@map("notification_deliveries")
}

model NotificationDevice {
  installationId String                @id @map("installation_id") @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  platform       CommunicationPlatform
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime              @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt      DateTime?             @map("revoked_at") @db.Timestamptz(3)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, revokedAt], map: "notification_devices_user_idx")
  @@map("notification_devices")
}

model CommunicationEventReceipt {
  consumerKey String   @map("consumer_key") @db.VarChar(80)
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumerKey, eventId])
  @@map("communication_event_receipts")
}

model CommunicationIdempotencyRecord {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  idempotencyKey       String   @map("idempotency_key") @db.Uuid
  method               String   @db.VarChar(8)
  canonicalPath        String   @map("canonical_path") @db.VarChar(200)
  requestFingerprint   String   @map("request_fingerprint") @db.Char(64)
  responseStatus       Int      @map("response_status") @db.SmallInt
  responseCiphertext   Bytes    @map("response_ciphertext")
  encryptionKeyVersion Int      @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '24 hours'")) @map("expires_at") @db.Timestamptz(3)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([userId, method, canonicalPath, idempotencyKey], map: "communication_idempotency_scope_key")
  @@index([expiresAt], map: "communication_idempotency_expiry_idx")
  @@map("communication_idempotency_records")
}
