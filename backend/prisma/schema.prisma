// Advertising data contract. Only coarse contextual rules and purpose-bound cap hashes are stored.
enum AdCampaignState {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  ACTIVE
  PAUSED
  EXHAUSTED
  COMPLETED
  REJECTED

  @@map("ad_campaign_state")
}

enum AdCreativeFormat {
  STATIC_IMAGE
  TEXT_IMAGE_CARD

  @@map("ad_creative_format")
}

enum AdBillingModel {
  CPM
  CPC
  FIXED_SPONSORSHIP

  @@map("ad_billing_model")
}

enum AdPriorityTier {
  HOUSE_EMERGENCY
  GUARANTEED_DIRECT
  STANDARD_DIRECT

  @@map("ad_priority_tier")
}

enum AdTargetDimension {
  SURFACE
  CLIENT_KIND
  LOCALE
  FORM_FACTOR
  OBJECT_CLASS
  CONTENT_CATEGORY
  COUNTRY
  REGION
  CITY
  CONNECTIVITY

  @@map("ad_target_dimension")
}

enum AdTargetOperator {
  INCLUDE
  EXCLUDE

  @@map("ad_target_operator")
}

enum AdDeliverySource {
  DIRECT
  EXTERNAL_FALLBACK
  HOUSE

  @@map("ad_delivery_source")
}

enum AdDeliveryEventKind {
  ISSUED
  VIEWABLE_IMPRESSION
  VALID_CLICK
  INVALID_CLICK
  RESERVATION_RELEASED

  @@map("ad_delivery_event_kind")
}

enum AdCampaignDecisionKind {
  SUBMIT
  APPROVE
  REJECT
  PAUSE
  RESUME

  @@map("ad_campaign_decision_kind")
}

model Campaign {
  id                 String               @id @db.Uuid
  version            BigInt               @default(0)
  state              AdCampaignState      @default(DRAFT)
  advertiserName     String               @map("advertiser_name") @db.VarChar(160)
  advertiserLegalId  String               @map("advertiser_legal_id") @db.VarChar(120)
  timezone           String               @db.VarChar(64)
  startsAt           DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime             @map("ends_at") @db.Timestamptz(3)
  currency           String               @db.Char(3)
  budgetMinor        BigInt               @map("budget_minor")
  reservedMinor      BigInt               @default(0) @map("reserved_minor")
  spentMinor         BigInt               @default(0) @map("spent_minor")
  currentRevisionId  String?              @unique(map: "campaigns_current_revision_key") @map("current_revision_id") @db.Uuid
  approvedRevisionId String?              @unique(map: "campaigns_approved_revision_key") @map("approved_revision_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)
  revisions          CampaignRevision[]   @relation("CampaignRevisions")
  currentRevision    CampaignRevision?    @relation("CurrentCampaignRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedRevision   CampaignRevision?    @relation("ApprovedCampaignRevision", fields: [approvedRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creatives          Creative[]
  counters           DeliveryCounter[]
  events             AdDeliveryEvent[]
  reports            AdReportDaily[]
  decisions          AdCampaignDecision[]

  @@index([state, startsAt, endsAt], map: "campaigns_delivery_idx")
  @@map("campaigns")
}

