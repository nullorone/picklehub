  score             Json
  supersedesId      String?         @map("supersedes_id") @db.Uuid
  reasonCode        String?         @map("reason_code") @db.VarChar(96)
  recordedByUserId  String          @map("recorded_by_user_id") @db.Uuid
  recordedAt        DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)
  match             TournamentMatch @relation(fields: [tournamentMatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tournamentMatchId, revision], map: "tournament_match_results_revision_key")
  @@map("tournament_match_results")
}

model Standing {
  tournamentId      String     @map("tournament_id") @db.Uuid
  stageId           String?    @map("stage_id") @db.Uuid
  entrantId         String     @map("entrant_id") @db.Uuid
  revision          Int
  rank              Int        @db.SmallInt
  matchPoints       Int        @map("match_points")
  wins              Int
  gameDifferential  Int        @map("game_differential")
  pointDifferential Int        @map("point_differential")
  pointsScored      Int        @map("points_scored")
  tieBreakLot       BigInt     @map("tie_break_lot")
  detail            Json
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entrant           Entrant    @relation(fields: [entrantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tournamentId, entrantId, revision])
  @@unique([tournamentId, revision, rank], map: "tournament_standings_rank_key")
  @@index([tournamentId, revision, rank], map: "tournament_standings_projection_idx")
  @@map("tournament_standings")
}

model PaymentMark {
