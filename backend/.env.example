NODE_ENV=local
APP_ROLE=api
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://picklehub:picklehub@localhost:5432/picklehub?schema=public
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=local
LOG_LEVEL=info
DEPENDENCY_TIMEOUT_MS=1000
SHUTDOWN_GRACE_MS=10000
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_CLAIM_TTL_MS=30000
IDENTITY_HMAC_KEY=replace-with-at-least-32-random-characters
IDENTITY_ENCRYPTION_KEY=replace-with-64-lowercase-hex-characters
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
IDENTITY_ALLOWED_ORIGINS=https://app.example.test,https://tma.example.test
MAGIC_LINK_BASE_URL=https://app.example.test/auth/email
EMAIL_PROVIDER_ENDPOINT=https://approved-provider.example.test/v1/magic-email
EMAIL_PROVIDER_TOKEN=replace-with-at-least-32-random-characters
# Venue providers remain disabled until legal/residency review. Set a complete group only after approval.
# VENUE_PROVIDER_POLICY_VERSION=review-YYYY-MM-DD
# VENUE_OVERPASS_ENDPOINT=https://approved-overpass.example.test/api/interpreter
# VENUE_OVERPASS_USER_AGENT=PickleHub/0.1 operations@example.test
# VENUE_OVERPASS_LICENSE=ODbL-1.0
# VENUE_OVERPASS_ATTRIBUTION_TEXT=© OpenStreetMap contributors
# VENUE_OVERPASS_ATTRIBUTION_LINK=https://www.openstreetmap.org/copyright
VENUE_OVERPASS_STORAGE_ALLOWED=false
VENUE_OVERPASS_MIN_INTERVAL_MS=10000
# VENUE_GEOCODER_ENDPOINT=https://approved-geocoder.example.test/search
# VENUE_GEOCODER_TOKEN=replace-with-provider-token
VENUE_GEOCODER_STORAGE_ALLOWED=false
# VENUE_GEOCODER_LICENSE=provider-license
# VENUE_GEOCODER_ATTRIBUTION_TEXT=Provider attribution
# VENUE_GEOCODER_ATTRIBUTION_LINK=https://provider.example.test/attribution
MATCH_POLICY_VERSION=matches-v1
MATCH_PUBLISH_MINIMUM_LEAD_MINUTES=30
MATCH_PUBLISH_HORIZON_DAYS=90
MATCH_WAITLIST_OFFER_MINUTES=30
MATCH_START_EARLY_MINUTES=30
MATCH_START_LATE_HOURS=6
MATCH_RESULT_DEADLINE_HOURS=72
MATCH_CONFIRMATION_DEADLINE_HOURS=48
COMMUNICATION_DELIVERY_POLL_INTERVAL_MS=1000
COMMUNICATION_DELIVERY_MAX_ATTEMPTS=8
COMMUNICATION_PROVIDER_TIMEOUT_MS=5000
COMMUNICATION_ENCRYPTION_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
NOTIFICATION_TELEGRAM_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
# NOTIFICATION_EMAIL_PROVIDER_ENDPOINT=https://provider.example/v1/notifications
# NOTIFICATION_EMAIL_PROVIDER_TOKEN=replace-with-provider-token
# Profile integrations remain fail-closed until provider/legal, security and residency review.
# PROFILE_DUPR_POLICY_VERSION=review-YYYY-MM-DD
PROFILE_DUPR_ALLOWED_HOSTS=
PROFILE_DUPR_ALLOWED_PATH_PATTERN=^/player/[^/]+/?$
PROFILE_DUPR_OUTBOUND_ENABLED=false
# PROFILE_AVATAR_STORAGE_BASE_URL=https://private-media-gateway.example.test
