NODE_ENV=local
APP_ROLE=api
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://picklehub:picklehub@localhost:5432/picklehub?schema=public
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=local
LOG_LEVEL=info
DEPENDENCY_TIMEOUT_MS=1000
SHUTDOWN_GRACE_MS=10000
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_CLAIM_TTL_MS=30000
IDENTITY_HMAC_KEY=replace-with-at-least-32-random-characters
IDENTITY_ENCRYPTION_KEY=replace-with-64-lowercase-hex-characters
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
IDENTITY_ALLOWED_ORIGINS=https://app.example.test,https://tma.example.test
MAGIC_LINK_BASE_URL=https://app.example.test/auth/email
EMAIL_PROVIDER_ENDPOINT=https://approved-provider.example.test/v1/magic-email
