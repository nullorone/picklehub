{
    "name": "@picklehub/backend",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "start": "node dist/main.js",
        "start:worker": "node dist/worker.js",
        "dev": "tsx watch src/main.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "build": "tsc -p tsconfig.json",
        "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "format": "prettier --single-quote --trailing-comma es5 --print-width 120 --write \"src/**/*.ts\" \"test/**/*.ts\" *.json *.md",
        "format:check": "prettier --single-quote --trailing-comma es5 --print-width 120 --check \"src/**/*.ts\" \"test/**/*.ts\" *.json *.md",
        "test": "node --import tsx --test test/*.spec.ts",
        "check": "npm run prisma:generate && npm run format:check && npm run lint && npm run typecheck && npm test && npm run contracts:check && npm run build",
        "contracts:check": "node scripts/check-contract.mjs"
    },
    "dependencies": {
        "@prisma/client": "^6.16.2",
        "@nestjs/common": "^11.1.6",
        "@nestjs/core": "^11.1.6",
        "@nestjs/platform-express": "^11.1.6",
        "@prisma/client": "^6.16.2",
        "dotenv": "^16.6.1",
        "pg": "^8.16.3",
        "prisma": "^6.16.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@types/express": "^5.0.3",
        "@types/node": "^22.18.6",
        "@types/pg": "^8.15.5",
        "eslint": "^9.34.0",
        "prettier": "^3.5.3",
        "prisma": "^6.16.2",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2"
    }
}
