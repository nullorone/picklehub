{
    "name": "@picklehub/backend",
    "version": "0.1.0",
    "private": true,
    "description": "PickleHub modular monolith backend",
    "engines": {
        "node": ">=22 <23"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsx watch src/main.ts",
        "dev:worker": "tsx watch src/worker.ts",
        "start": "node dist/main.js",
        "start:worker": "node dist/worker.js",
        "lint": "eslint src test --max-warnings=0",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "jest --config jest.unit.config.cjs --runInBand",
        "test:integration": "jest --config jest.integration.config.cjs --runInBand",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:validate": "prisma validate"
    },
    "dependencies": {
        "@nestjs/common": "11.1.6",
        "@nestjs/core": "11.1.6",
        "@nestjs/platform-express": "11.1.6",
        "@prisma/adapter-pg": "6.16.2",
        "@prisma/client": "6.16.2",
        "bullmq": "5.58.5",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.2",
        "dotenv": "16.6.1",
        "ioredis": "5.7.0",
        "pino": "9.9.4",
        "pg": "8.16.3",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.1.5"
    },
    "devDependencies": {
        "@eslint/js": "9.35.0",
        "@nestjs/testing": "11.1.6",
        "@types/express": "5.0.3",
        "@types/jest": "30.0.0",
        "@types/node": "22.18.1",
        "@types/pg": "8.15.5",
        "@types/supertest": "6.0.3",
        "eslint": "9.35.0",
        "eslint-config-prettier": "10.1.8",
        "jest": "30.1.3",
        "prisma": "6.16.2",
        "supertest": "7.1.4",
        "ts-jest": "29.4.1",
        "tsx": "4.20.5",
        "typescript-eslint": "8.42.0"
    }
}
