{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**", ".expo/**"],
            "env": ["VITE_*", "NODE_ENV"]
        },
        "lint": {
            "dependsOn": ["^lint"],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["^typecheck"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test:integration": {
            "dependsOn": ["build"],
            "cache": false,
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
