{"nodes": [{"id": "llm__docs_telegram_serverless_summary_document", "label": "Telegram Serverless: \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f PickleHub", "file_type": "document", "source_file": "llm/_docs/telegram-serverless-summary.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm__docs_telegram_serverless_summary_research", "label": "Serverless migration not adopted", "file_type": "concept", "source_file": "llm/_docs/telegram-serverless-summary.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Dated 2026-10-06 research; proposals do not modify current TypeSpec or deploy functions."}, {"id": "llm__docs_telegram_serverless_summary_runtime", "label": "V8 modules and SQLite runtime", "file_type": "concept", "source_file": "llm/_docs/telegram-serverless-summary.md", "source_location": "\u041a\u0430\u043a \u0432\u0441\u0451 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "No Node APIs, npm runtime or filesystem; NestJS/Prisma cannot be uploaded unchanged."}, {"id": "llm__docs_telegram_serverless_summary_rpc", "label": "Proposed nine-operation RPC adapter", "file_type": "concept", "source_file": "llm/_docs/telegram-serverless-summary.md", "source_location": "\u0412\u0441\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0442\u0435\u043a\u0443\u0449\u0435\u0433\u043e MVP", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "getProfile/listGames/getGame/createGame/updateGame/joinGame/leaveGame/removeParticipant/cancelGame map existing operations; ctx identity still requires organizer checks."}, {"id": "llm__docs_telegram_serverless_summary_invariant_gap", "label": "Unconfirmed transaction and scheduling guarantees", "file_type": "concept", "sourc